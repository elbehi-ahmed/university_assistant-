{#
  ============================================================
  templates/student/matieres.html.twig
  ============================================================
  TODO Membre 3 : Le Controller StudentSubjectsController::index()
  doit passer les variables suivantes à cette vue :
    - subjects (array) : liste des matières de l'étudiant, chaque élément contient :
        • id          (int)    : identifiant de la matière
        • name        (string) : nom de la matière (ex: "Mathematics")
        • icon        (string) : classe FontAwesome (ex: "fa-square-root-alt")
        • hue         (int)    : teinte CSS HSL pour l'icône (ex: 38)
        • coefficient (int)    : coefficient de la matière
        • taskCount   (int)    : nombre de tâches liées
        • examCount   (int)    : nombre d'examens liés
  Route Symfony attendue : 'app_student_subjects'
  ============================================================
#}
{% extends 'base.html.twig' %}

{% block title %}Subjects{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/matieres.css') }}" />
{% endblock %}

{% block page_title %}Subjects{% endblock %}
{% block page_breadcrumb %}<span>Dashboard</span> / Subjects{% endblock %}

{% block body %}
  {# ── Toolbar ── #}
  <div class="flex items-center justify-between mb-24 anim-1">
    <div class="search-wrap">
      <i class="fas fa-search search-icon"></i>
      <input class="search-input" type="text" placeholder="Search subjects…" oninput="filterSubjects(this.value)" />
    </div>
    <button class="btn btn-primary" onclick="openModal('add')">
      <i class="fas fa-plus"></i> Add subject
    </button>
  </div>

  {# ── Subject cards grid ── #}
  <div class="subjects-grid anim-2" id="subjects-grid">
    {% for subject in subjects %}
      <div class="subject-card" data-name="{{ subject.name|lower }}">
        <div class="subject-icon" style="--hue: {{ subject.hue }}">
          <i class="fas {{ subject.icon }}"></i>
        </div>
        <div class="subject-info">
          <div class="subject-name">{{ subject.name }}</div>
          <div class="subject-coeff">Coefficient <strong>{{ subject.coefficient }}</strong></div>
        </div>
        <div class="subject-stats">
          <span class="badge {{ subject.taskCount > 0 ? 'badge-warning' : 'badge-muted' }}">
            {{ subject.taskCount }} {{ subject.taskCount == 1 ? 'task' : 'tasks' }}
          </span>
          <span class="badge {{ subject.examCount > 0 ? 'badge-danger' : 'badge-muted' }}">
            {{ subject.examCount }} {{ subject.examCount == 1 ? 'exam' : 'exams' }}
          </span>
        </div>
        <div class="subject-actions">
          <button class="btn btn-ghost btn-icon btn-sm" onclick="openModal('edit', '{{ subject.name|e('js') }}', {{ subject.coefficient }})" data-tip="Edit">
            <i class="fas fa-pen"></i>
          </button>
          <button class="btn btn-danger btn-icon btn-sm" onclick="confirmDelete('{{ subject.name|e('js') }}')" data-tip="Delete">
            <i class="fas fa-trash"></i>
          </button>
        </div>
      </div>
    {% else %}
      <p style="color: var(--muted); grid-column: 1/-1; text-align: center;">No subjects found.</p>
    {% endfor %}
  </div>

  {# ── Add / Edit Modal ── #}
  <div class="modal-overlay" id="subject-modal" onclick="handleOverlayClick(event)">
    <div class="modal">
      <div class="modal-head">
        <div class="modal-title" id="modal-title">Add subject</div>
        <button class="modal-close" onclick="closeModal()"><i class="fas fa-times"></i></button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Subject name</label>
          <input class="form-control" type="text" id="m-name" placeholder="e.g. Mathematics" />
        </div>
        <div class="form-group">
          <label class="form-label">Coefficient</label>
          <input class="form-control" type="number" id="m-coeff" min="1" max="10" placeholder="e.g. 4" />
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
        <button class="btn btn-primary" onclick="saveSubject()">Save subject</button>
      </div>
    </div>
  </div>

  {# ── Delete confirm modal ── #}
  <div class="modal-overlay" id="delete-modal" onclick="handleOverlayClick(event)">
    <div class="modal" style="max-width: 400px">
      <div class="modal-head">
        <div class="modal-title">Delete subject</div>
        <button class="modal-close" onclick="closeDeleteModal()"><i class="fas fa-times"></i></button>
      </div>
      <div class="modal-body">
        <p style="font-size: 0.9rem; color: var(--muted-less); line-height: 1.65;">
          Are you sure you want to delete
          <strong id="delete-name" style="color: var(--white)"></strong>? All
          associated tasks and exams will also be removed. This action cannot be undone.
        </p>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" onclick="closeDeleteModal()">Cancel</button>
        <button class="btn btn-danger" onclick="closeDeleteModal()">
          <i class="fas fa-trash"></i> Delete
        </button>
      </div>
    </div>
  </div>
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/student.js') }}"></script>
{% endblock %}