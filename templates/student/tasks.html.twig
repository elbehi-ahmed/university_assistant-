{#
  templates/student/tasks.html.twig

  ══════════════════════════════════════════════════════════════════
  TODO Membre 3 (Student Backend) — StudentTasksController
  ══════════════════════════════════════════════════════════════════

  Variables obligatoires à passer depuis le Controller :

  1. tasks (Task[]) — Tableau d'objets Task trié par dueDate ASC.
     Chaque objet expose :
       · task.id            (int)      Identifiant                  ex: 42
       · task.title         (string)   Titre                        ex: "TP Algorithmes"
       · task.description   (string|null) Description courte        ex: "Implémenter BFS"
       · task.subject       (string)   Matière                      ex: "Algorithmique"
       · task.dueDate       (DateTime) Date d'échéance
       · task.status        (string)   'todo' | 'done'
       · task.priority      (string)   'high' | 'medium' | 'low'
       · task.deadlineClass (string)   Calculé côté Controller :
                                         dueDate < now+2j  → 'urgent'
                                         dueDate < now+7j  → 'soon'
                                         sinon             → ''

  2. taskCounts (array) — Compteurs pour les summary pills.
       · taskCounts.total  (int)
       · taskCounts.todo   (int)
       · taskCounts.done   (int)
       · taskCounts.urgent (int)  tâches priority=high AND status=todo

  3. subjects (string[]) — Liste des matières distinctes de l'étudiant,
     pour alimenter le filtre déroulant.         ex: ["Algorithmique","Réseaux"]

  4. urgentTaskCount  (int) — Badge sidebar (= taskCounts.urgent)
  5. upcomingExamCount (int) — Badge sidebar exams (passer 0 si indisponible)

  Exemple de render() :
    return $this->render('student/tasks.html.twig', [
        'tasks'             => $tasks,
        'taskCounts'        => $taskCounts,
        'subjects'          => $subjects,
        'urgentTaskCount'   => $taskCounts['urgent'],
        'upcomingExamCount' => $upcomingExamCount,
    ]);
  ══════════════════════════════════════════════════════════════════
#}

{% extends 'base.html.twig' %}

{% block title %}My Tasks{% endblock %}
{% block page_title %}My Tasks{% endblock %}
{% block page_breadcrumb %}Dashboard / <span>Tasks</span>{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/taches.css') }}" />
{% endblock %}

{% block body %}
<div class="page-content">

  {# ── Summary Pills ── #}
  <div class="task-summary anim-1">
    <button class="summary-pill active" onclick="filterByStatus('all', this)">
      <i class="fas fa-list"></i> All tasks
      <span class="pill-count">{{ taskCounts.total|default(0) }}</span>
    </button>
    <button class="summary-pill" onclick="filterByStatus('todo', this)">
      <i class="fas fa-hourglass-half"></i> To Do
      <span class="pill-count">{{ taskCounts.todo|default(0) }}</span>
    </button>
    <button class="summary-pill" onclick="filterByStatus('done', this)">
      <i class="fas fa-check-circle"></i> Done
      <span class="pill-count">{{ taskCounts.done|default(0) }}</span>
    </button>
    <button class="summary-pill" onclick="filterByStatus('urgent', this)">
      <i class="fas fa-fire"></i> Urgent
      <span class="pill-count">{{ taskCounts.urgent|default(0) }}</span>
    </button>
  </div>

  {# ── Main Card ── #}
  <div class="card anim-2">

    {# ── Toolbar ── #}
    <div class="card-head">
      <div>
        <div class="card-title">Task List</div>
        <div class="gold-line"></div>
      </div>
      <div class="tasks-toolbar" style="margin-bottom:0;">
        <div class="filter-group">
          <div class="search-wrap">
            <i class="fas fa-search search-icon"></i>
            <input class="search-input filter-select" type="text" id="searchInput"
                   placeholder="Search tasks…" oninput="filterTable()" style="width:200px;" />
          </div>
          <select class="form-control filter-select" id="subjectFilter" onchange="filterTable()">
            <option value="">All subjects</option>
            {% for subject in subjects|default([]) %}
              <option value="{{ subject|lower }}">{{ subject }}</option>
            {% endfor %}
          </select>
          <select class="form-control filter-select" id="priorityFilter" onchange="filterTable()">
            <option value="">All priorities</option>
            <option value="high">High</option>
            <option value="medium">Medium</option>
            <option value="low">Low</option>
          </select>
        </div>
      </div>
    </div>

    {# ── Table ── #}
    <div class="card-body" style="padding:0;">
      {% if tasks is defined and tasks|length > 0 %}
        <div class="table-wrap">
          <table id="tasksTable">
            <thead>
              <tr>
                <th style="width:36px;"></th>
                <th>Task</th>
                <th>Subject</th>
                <th>Due Date</th>
                <th>Priority</th>
                <th>Status</th>
                <th style="text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for task in tasks %}
                <tr class="task-row"
                    data-status="{{ task.status }}"
                    data-priority="{{ task.priority }}"
                    data-subject="{{ task.subject|lower }}">

                  <td style="padding-left:20px;">
                    <input type="checkbox" class="task-check"
                           {% if task.status == 'done' %}checked{% endif %}
                           onchange="toggleTask(this, {{ task.id }})" />
                  </td>

                  <td>
                    <div class="task-name {% if task.status == 'done' %}done-text{% endif %}">
                      {{ task.title }}
                    </div>
                    {% if task.description %}
                      <div class="task-desc-preview">
                        {{ task.description|slice(0, 80) }}{% if task.description|length > 80 %}…{% endif %}
                      </div>
                    {% endif %}
                  </td>

                  <td>
                    <span class="badge badge-info">{{ task.subject }}</span>
                  </td>

                  <td>
                    {# deadlineClass calculé côté Controller : 'urgent' | 'soon' | '' #}
                    <span class="deadline {{ task.deadlineClass|default('') }}">
                      <i class="fas fa-calendar-alt"></i>
                      {{ task.dueDate|date('d M Y') }}
                    </span>
                  </td>

                  <td>
                    {% if task.priority == 'high' %}
                      <span class="badge priority-high"><i class="fas fa-arrow-up"></i> High</span>
                    {% elseif task.priority == 'medium' %}
                      <span class="badge priority-medium"><i class="fas fa-minus"></i> Medium</span>
                    {% else %}
                      <span class="badge priority-low"><i class="fas fa-arrow-down"></i> Low</span>
                    {% endif %}
                  </td>

                  <td>
                    {% if task.status == 'done' %}
                      <span class="status-pill done">Done</span>
                    {% else %}
                      <span class="status-pill todo">To Do</span>
                    {% endif %}
                  </td>

                  <td>
                    <div class="row-actions">
                      {# TODO Membre 3 : path('app_student_task_show', {id: task.id}) #}
                      <a href="#" class="btn btn-ghost btn-sm btn-icon" data-tip="View details">
                        <i class="fas fa-eye"></i>
                      </a>
                      {# TODO Membre 3 : Protéger avec CSRF token — csrf_token('delete_task_' ~ task.id) #}
                      <button class="btn btn-danger btn-sm btn-icon" data-tip="Delete"
                              onclick="confirmDelete({{ task.id }})">
                        <i class="fas fa-trash"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

      {% else %}
        <div class="empty-state">
          <div class="empty-icon"><i class="fas fa-clipboard-check"></i></div>
          <div class="empty-title">No tasks found</div>
          <div class="empty-desc">
            You have no tasks assigned yet. They will appear here once your teachers add them.
          </div>
        </div>
      {% endif %}
    </div>
  </div>

</div>
{% endblock %}

{% block javascripts %}
<script>
  function filterTable() {
    const search   = document.getElementById('searchInput').value.toLowerCase();
    const subject  = document.getElementById('subjectFilter').value.toLowerCase();
    const priority = document.getElementById('priorityFilter').value.toLowerCase();

    document.querySelectorAll('.task-row').forEach(row => {
      const text       = row.innerText.toLowerCase();
      const rowSubject = row.dataset.subject ?? '';
      const rowPrio    = row.dataset.priority ?? '';

      const ok = text.includes(search)
              && (!subject  || rowSubject.includes(subject))
              && (!priority || rowPrio === priority);

      row.style.display = ok ? '' : 'none';
    });
  }

  function filterByStatus(status, btn) {
    document.querySelectorAll('.summary-pill').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');

    document.querySelectorAll('.task-row').forEach(row => {
      if (status === 'all') {
        row.style.display = '';
      } else if (status === 'urgent') {
        row.style.display =
          (row.dataset.priority === 'high' && row.dataset.status === 'todo') ? '' : 'none';
      } else {
        row.style.display = row.dataset.status === status ? '' : 'none';
      }
    });
  }

  function toggleTask(checkbox, taskId) {
    const row      = checkbox.closest('tr');
    const nameEl   = row.querySelector('.task-name');
    const pill     = row.querySelector('.status-pill');

    if (checkbox.checked) {
      nameEl?.classList.add('done-text');
      if (pill) { pill.className = 'status-pill done'; pill.textContent = 'Done'; }
      row.dataset.status = 'done';
    } else {
      nameEl?.classList.remove('done-text');
      if (pill) { pill.className = 'status-pill todo'; pill.textContent = 'To Do'; }
      row.dataset.status = 'todo';
    }
    /*
      TODO Membre 3 : Appel AJAX vers POST /student/tasks/{id}/toggle
      fetch(`/student/tasks/${taskId}/toggle`, {
        method: 'POST',
        headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content }
      });
    */
  }

  function confirmDelete(taskId) {
    if (confirm('Delete this task? This action cannot be undone.')) {
      /* TODO Membre 3 : window.location.href = `/student/tasks/${taskId}/delete?_token=...`; */
    }
  }
</script>
{% endblock %}