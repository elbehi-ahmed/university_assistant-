{% extends 'base.html.twig' %}

{# TODO Membre 3 : Ce Controller (StudentDashboardController) doit passer :
   - stats         : array avec les clés :
                       subjectCount      (int) — nombre de matières ce semestre
                       urgentTaskCount   (int) — tâches dues cette semaine
                       doneTaskCount     (int) — tâches terminées
                       upcomingExamCount (int) — examens à venir
                       daysUntilNextExam (int) — jours avant le prochain examen
   - tasks         : Task[]   — liste des tâches urgentes à afficher (max 3)
                     Chaque Task expose : title, priority ('high'|'medium'|'low'),
                     subject.name, dueLabel (string, ex: "Due tomorrow"),
                     progressPercent (int 0-100)
   - exams         : Exam[]   — liste des examens à venir (max 2)
                     Chaque Exam expose : examDate (DateTime), subject.name,
                     room, time (string ex: "09:00"), daysUntil (int),
                     urgencyBadgeClass ('badge-danger'|'badge-warning')
   - subjects      : Subject[] — matières du semestre avec leur progression
                     Chaque Subject expose : name, progressPercent (int 0-100),
                     progressBarClass (''|'success'|'danger')
#}

{% set stats = stats|default({}) %}
{% set tasks = tasks|default([]) %}
{% set exams = exams|default([]) %}
{% set subjects = subjects|default([]) %}

{% block title %}Dashboard{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}" />
{% endblock %}

{% block page_title %}Dashboard{% endblock %}

{% block page_breadcrumb %}
  {# TODO Membre 3 : app.user.prenom via l'entité User #}
  Welcome back, <span>{{ app.user is defined and app.user ? app.user.prenom|default('Utilisateur') : 'Utilisateur' }}</span>
{% endblock %}

{% block body %}

  {# ── Stat cards (source : dashboard.html — section .grid-4) ── #}
  <div class="grid-4 mb-32 anim-1">

    <div class="stat-card">
      <div class="stat-icon gold"><i class="fas fa-book-open"></i></div>
      <div class="stat-data">
        {# TODO Membre 3 : stats.subjectCount #}
        <div class="stat-value">{{ stats.subjectCount|default(0) }}</div>
        <div class="stat-label">Subjects</div>
        <div class="stat-change up">
          <i class="fas fa-arrow-up"></i> This semester
        </div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon danger"><i class="fas fa-exclamation-circle"></i></div>
      <div class="stat-data">
        {# TODO Membre 3 : stats.urgentTaskCount #}
        <div class="stat-value">{{ stats.urgentTaskCount|default(0) }}</div>
        <div class="stat-label">Urgent tasks</div>
        <div class="stat-change down">
          <i class="fas fa-clock"></i> Due this week
        </div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon success"><i class="fas fa-check-circle"></i></div>
      <div class="stat-data">
        {# TODO Membre 3 : stats.doneTaskCount #}
        <div class="stat-value">{{ stats.doneTaskCount|default(0) }}</div>
        <div class="stat-label">Tasks done</div>
        <div class="stat-change up">
          <i class="fas fa-arrow-up"></i> +4 this week
        </div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon warning"><i class="fas fa-calendar-day"></i></div>
      <div class="stat-data">
        {# TODO Membre 3 : stats.upcomingExamCount #}
        <div class="stat-value">{{ stats.upcomingExamCount|default(0) }}</div>
        <div class="stat-label">Upcoming exams</div>
        <div class="stat-change down">
          {# TODO Membre 3 : stats.daysUntilNextExam #}
          <i class="fas fa-clock"></i> Next: {{ stats.daysUntilNextExam|default(0) }} days
        </div>
      </div>
    </div>

  </div>

  {# ── Row : Urgent tasks + right column (source : dashboard.html — section .dash-row) ── #}
  <div class="dash-row anim-2">

    {# ── Urgent Tasks ── #}
    <div class="card">
      <div class="card-head">
        <div>
          <div class="card-title">Urgent Tasks</div>
          <div class="gold-line"></div>
        </div>
        <a href="{{ path('app_student_tasks') }}" class="btn btn-ghost btn-sm">
          View all <i class="fas fa-arrow-right"></i>
        </a>
      </div>
      <div class="card-body">
        <div class="task-list">

          {# TODO Membre 3 : boucler sur tasks[] — max 3 tâches urgentes triées par deadline #}
          {% for task in tasks %}

            {# Calcul des classes CSS selon la priorité (reproduit le comportement du HTML statique) #}
            {% set taskPriority = task.priority|default('low') %}
            {% if taskPriority == 'high' %}
              {% set barClass    = 'danger' %}
              {% set badgeClass  = 'badge-danger' %}
              {% set badgeLabel  = 'High priority' %}
              {% set pbClass     = 'danger' %}
              {% set itemClass   = 'urgent' %}
            {% elseif taskPriority == 'medium' %}
              {% set barClass    = 'warning' %}
              {% set badgeClass  = 'badge-warning' %}
              {% set badgeLabel  = 'Medium' %}
              {% set pbClass     = '' %}
              {% set itemClass   = '' %}
            {% else %}
              {% set barClass    = 'info' %}
              {% set badgeClass  = 'badge-info' %}
              {% set badgeLabel  = 'Low' %}
              {% set pbClass     = '' %}
              {% set itemClass   = '' %}
            {% endif %}

            <div class="task-item {{ itemClass }}">
              <div class="task-priority-bar {{ barClass }}"></div>
              <div class="task-content">
                <div class="task-title">{{ task.title|default('Untitled task') }}</div>
                <div class="task-meta">
                  <span class="badge {{ badgeClass }}">{{ badgeLabel }}</span>
                  {# TODO Membre 3 : task.subject.name #}
                  <span class="task-subject">
                    {{ task.subject is defined and task.subject ? task.subject.name|default('Unknown subject') : 'Unknown subject' }}
                  </span>
                  <span class="task-date">
                    {# TODO Membre 3 : task.dueLabel (string calculé côté Controller, ex: "Due tomorrow") #}
                    <i class="far fa-clock"></i> {{ task.dueLabel|default('No due date') }}
                  </span>
                </div>
                <div class="progress-wrap mt-8">
                  {# TODO Membre 3 : task.progressPercent (int 0-100) #}
                  <div class="progress-bar {{ pbClass }}" style="width: {{ task.progressPercent|default(0) }}%"></div>
                </div>
              </div>
              <div class="task-actions">
                <button class="btn btn-ghost btn-icon btn-sm" data-tip="Edit">
                  <i class="fas fa-pen"></i>
                </button>
              </div>
            </div>

          {% else %}
            <div class="empty-state">No urgent tasks.</div>
          {% endfor %}

        </div>
      </div>
    </div>

    {# ── Right column ── #}
    <div class="right-col">

      {# ── Upcoming Exams ── #}
      <div class="card mb-16">
        <div class="card-head">
          <div>
            <div class="card-title">Upcoming Exams</div>
            <div class="gold-line"></div>
          </div>
          <a href="{{ path('app_student_exams') }}" class="btn btn-ghost btn-sm">
            View all <i class="fas fa-arrow-right"></i>
          </a>
        </div>
        <div class="card-body">
          <div class="exam-list">

            {# TODO Membre 3 : boucler sur exams[] — max 2 examens à venir #}
            {% for exam in exams %}
              {% set examDate = exam.examDate|default(null) %}
              <div class="exam-item">
                <div class="exam-date-box">
                  {# TODO Membre 3 : exam.examDate est un objet DateTime #}
                  <span class="exam-day">{{ examDate ? examDate|date('d') : '--' }}</span>
                  <span class="exam-month">{{ examDate ? examDate|date('M') : '---' }}</span>
                </div>
                <div class="exam-info">
                  {# TODO Membre 3 : exam.subject.name #}
                  <div class="exam-subject">{{ exam.subject is defined and exam.subject ? exam.subject.name|default('Unknown subject') : 'Unknown subject' }}</div>
                  <div class="exam-detail">
                    {# TODO Membre 3 : exam.room, exam.time #}
                    <i class="fas fa-map-marker-alt"></i> {{ exam.room|default('TBA') }}
                    &nbsp;·&nbsp;
                    <i class="far fa-clock"></i> {{ exam.time|default('TBA') }}
                  </div>
                </div>
                {# TODO Membre 3 : exam.daysUntil (int), exam.urgencyBadgeClass ('badge-danger'|'badge-warning') #}
                <span class="badge {{ exam.urgencyBadgeClass|default('badge-warning') }}">{{ exam.daysUntil|default(0) }} days</span>
              </div>
            {% else %}
              <div class="empty-state">No upcoming exams.</div>
            {% endfor %}

          </div>
        </div>
      </div>

      {# ── Semester Progress ── #}
      <div class="card">
        <div class="card-head">
          <div>
            <div class="card-title">Semester Progress</div>
            <div class="gold-line"></div>
          </div>
        </div>
        <div class="card-body">
          <div class="subject-progress-list">

            {# TODO Membre 3 : boucler sur subjects[]
               Chaque Subject expose : name, progressPercent (int 0-100),
               progressBarClass (''|'success'|'danger') #}
            {% for subject in subjects %}
              <div class="sp-item">
                <div class="flex justify-between mb-8">
                  <span class="sp-name">{{ subject.name|default('Unknown subject') }}</span>
                  <span class="sp-pct">{{ subject.progressPercent|default(0) }}%</span>
                </div>
                <div class="progress-wrap">
                  <div class="progress-bar {{ subject.progressBarClass|default('') }}" style="width: {{ subject.progressPercent|default(0) }}%"></div>
                </div>
              </div>
            {% else %}
              <div class="empty-state">No subjects yet.</div>
            {% endfor %}

          </div>
        </div>
      </div>

    </div>{# /right-col #}

  </div>{# /dash-row #}

{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/student.js') }}"></script>
{% endblock %}