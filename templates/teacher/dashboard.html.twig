{% extends 'base.html.twig' %}

{# TODO Membre 4 : Ce Controller (TeacherDashboardController) doit passer :
   - stats          : array avec les clés :
                        activeClassCount   (int) — classes actives
                        totalStudents      (int) — total étudiants
                        openAssignments    (int) — devoirs ouverts
                        submissionRate     (int) — taux de soumission en %
   - classes        : TeacherClass[] — liste des classes pour la grille "My Classes" (max 3 affichés)
                      Chaque TeacherClass expose :
                        iconClass        (string CSS : 'math'|'physics'|'cs'|'chem'|'english')
                        iconFaClass      (string : 'fa-square-root-alt'|'fa-atom'|'fa-code'|...)
                        name             (string)
                        code             (string, ex: "MATH-301 · Sem 3")
                        studentCount     (int)
                        taskCount        (int)
                        curriculumProgress (int 0-100)
                        progressBarClass  (string : ''|'success'|'danger')
   - recentActivity : ActivityItem[] — activité récente (source : .activity-list)
                      Chaque ActivityItem expose :
                        iconBg           (string CSS inline, ex: "background:rgba(76,175,130,0.15);color:var(--success)")
                        iconFaClass      (string : 'fa-check'|'fa-star'|'fa-comment'|'fa-exclamation')
                        description      (string HTML safe, ex: "<strong>Yassine</strong> submitted…")
                        timeAgo          (string, ex: "2 hours ago")
                        classCode        (string, ex: "MATH-301")
#}

{% block title %}Teacher Dashboard{% endblock %}

{% block stylesheets %}
  {# Les styles spécifiques au teacher-dashboard sont inline dans le HTML source.
     TODO Membre 4 : extraire ces styles dans public/css/teacher-dashboard.css
     et remplacer cette balise par :
     <link rel="stylesheet" href="{{ asset('css/teacher-dashboard.css') }}" /> #}
  <style>
    .welcome-banner {
      background: linear-gradient(
        135deg,
        rgba(30, 48, 74, 0.95) 0%,
        rgba(22, 34, 54, 0.98) 60%,
        rgba(201, 168, 76, 0.08) 100%
      );
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 28px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      position: relative;
      overflow: hidden;
      margin-bottom: 28px;
    }
    .welcome-banner::before {
      content: "";
      position: absolute;
      right: -40px;
      top: -40px;
      width: 200px;
      height: 200px;
      background: radial-gradient(circle, rgba(201, 168, 76, 0.12) 0%, transparent 70%);
      pointer-events: none;
    }
    .welcome-text h2 {
      font-family: "Playfair Display", serif;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--white);
      margin-bottom: 6px;
    }
    .welcome-text p {
      font-size: 0.875rem;
      color: var(--muted);
      line-height: 1.6;
      max-width: 480px;
    }
    .welcome-icon {
      width: 72px;
      height: 72px;
      border-radius: 20px;
      background: linear-gradient(135deg, rgba(201, 168, 76, 0.2), rgba(201, 168, 76, 0.08));
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      color: var(--gold);
      flex-shrink: 0;
    }
    .classes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 18px;
    }
    .class-card {
      background: linear-gradient(145deg, rgba(30, 48, 74, 0.9), rgba(22, 34, 54, 0.95));
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-lg);
      padding: 22px;
      transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
      cursor: pointer;
      text-decoration: none;
      display: block;
    }
    .class-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-deep);
      border-color: var(--border);
    }
    .class-card-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 16px;
    }
    .class-icon {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }
    .class-icon.math    { background: rgba(201,168,76,0.15);  color: var(--gold); }
    .class-icon.physics { background: rgba(76,143,224,0.15);  color: var(--info); }
    .class-icon.cs      { background: rgba(76,175,130,0.15);  color: var(--success); }
    .class-icon.chem    { background: rgba(224,168,76,0.15);  color: var(--warning); }
    .class-icon.english { background: rgba(224,92,92,0.15);   color: var(--danger); }
    .class-card-info { flex: 1; min-width: 0; }
    .class-name {
      font-family: "Playfair Display", serif;
      font-size: 1rem;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 3px;
    }
    .class-code { font-size: 0.72rem; color: var(--muted); letter-spacing: 0.06em; }
    .class-meta { display: flex; gap: 16px; margin-bottom: 14px; }
    .class-meta-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.78rem;
      color: var(--muted);
    }
    .class-meta-item i { font-size: 0.75rem; color: var(--gold); }
    .class-progress-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }
    .class-progress-label span  { font-size: 0.72rem; color: var(--muted); }
    .class-progress-label strong { font-size: 0.78rem; color: var(--gold-light); }
    .activity-list { display: flex; flex-direction: column; gap: 0; }
    .activity-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 14px 24px;
      border-bottom: 1px solid rgba(201,168,76,0.06);
      transition: background var(--transition);
    }
    .activity-item:last-child { border-bottom: none; }
    .activity-item:hover { background: rgba(201,168,76,0.04); }
    .activity-icon {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .activity-text { flex: 1; }
    .activity-text p { font-size: 0.845rem; color: var(--muted-less); line-height: 1.5; }
    .activity-text p strong { color: var(--white); }
    .activity-time { font-size: 0.72rem; color: var(--muted); margin-top: 3px; }
    .quick-actions { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .quick-action-btn {
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-md);
      padding: 16px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      cursor: pointer;
      text-decoration: none;
      transition: all var(--transition);
    }
    .quick-action-btn:hover {
      background: var(--gold-glow);
      border-color: var(--border);
      transform: translateY(-2px);
    }
    .quick-action-btn i   { font-size: 1.1rem; color: var(--gold); }
    .quick-action-btn span { font-size: 0.82rem; color: var(--muted-less); font-weight: 500; }
    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 24px;
    }
    @media (max-width: 1100px) {
      .dashboard-grid { grid-template-columns: 1fr; }
    }
  </style>
{% endblock %}

{% block page_title %}Teacher Dashboard{% endblock %}

{% block page_breadcrumb %}
  <span>Dashboard</span> / Overview
{% endblock %}

{% block body %}

  {# ── Welcome banner (source : teacher-dashboard.html) ── #}
  <div class="welcome-banner anim-1">
    <div class="welcome-text">
      {# TODO Membre 4 : app.user.prenom, stats.openAssignments, stats.upcomingExamCount #}
      <h2>Good morning, {{ app.user.prenom }} ✦</h2>
      <p>
        You have
        <strong style="color: var(--gold)">{{ stats.openAssignments }} assignments</strong>
        pending review and
        <strong style="color: var(--gold)">{{ stats.upcomingExamCount }} upcoming exams</strong>
        this week. Your students are waiting!
      </p>
    </div>
    <div class="welcome-icon">
      <i class="fas fa-chalkboard-teacher"></i>
    </div>
  </div>

  {# ── Stats row (source : teacher-dashboard.html — .grid-4) ── #}
  <div class="grid-4 mb-24 anim-2">

    <div class="stat-card">
      <div class="stat-icon gold"><i class="fas fa-door-open"></i></div>
      <div class="stat-data">
        {# TODO Membre 4 : stats.activeClassCount #}
        <div class="stat-value">{{ stats.activeClassCount }}</div>
        <div class="stat-label">Active Classes</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon info"><i class="fas fa-users"></i></div>
      <div class="stat-data">
        {# TODO Membre 4 : stats.totalStudents #}
        <div class="stat-value">{{ stats.totalStudents }}</div>
        <div class="stat-label">Total Students</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon warning"><i class="fas fa-file-alt"></i></div>
      <div class="stat-data">
        {# TODO Membre 4 : stats.openAssignments #}
        <div class="stat-value">{{ stats.openAssignments }}</div>
        <div class="stat-label">Assignments Open</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon success"><i class="fas fa-check-circle"></i></div>
      <div class="stat-data">
        {# TODO Membre 4 : stats.submissionRate #}
        <div class="stat-value">{{ stats.submissionRate }}%</div>
        <div class="stat-label">Submission Rate</div>
      </div>
    </div>

  </div>

  {# ── Main grid (source : teacher-dashboard.html — .dashboard-grid) ── #}
  <div class="dashboard-grid">

    {# ── Left : My Classes ── #}
    <div class="flex-col gap-24">
      <div class="anim-3">
        <div class="flex items-center justify-between mb-16">
          <div>
            <h3 style="font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--white)">
              My Classes
            </h3>
            <div class="gold-line"></div>
          </div>
          <a href="{{ path('app_teacher_classes') }}" class="btn btn-ghost btn-sm">
            <i class="fas fa-arrow-right"></i> View all
          </a>
        </div>

        <div class="classes-grid">

          {# TODO Membre 4 : boucler sur classes[] — max 3 affichées sur le dashboard
             Chaque TeacherClass expose les propriétés décrites dans le bloc de commentaire en haut #}
          {% for class in classes %}
            <a href="{{ path('app_teacher_classes') }}" class="class-card">
              <div class="class-card-header">
                <div class="class-icon {{ class.iconClass }}">
                  <i class="fas {{ class.iconFaClass }}"></i>
                </div>
                <div class="class-card-info">
                  <div class="class-name">{{ class.name }}</div>
                  <div class="class-code">{{ class.code }}</div>
                </div>
              </div>
              <div class="class-meta">
                <div class="class-meta-item">
                  <i class="fas fa-users"></i>{{ class.studentCount }} students
                </div>
                <div class="class-meta-item">
                  <i class="fas fa-tasks"></i>{{ class.taskCount }} tasks
                </div>
              </div>
              <div class="class-progress-label">
                <span>Curriculum progress</span>
                <strong>{{ class.curriculumProgress }}%</strong>
              </div>
              <div class="progress-wrap">
                <div class="progress-bar {{ class.progressBarClass }}" style="width: {{ class.curriculumProgress }}%"></div>
              </div>
            </a>
          {% endfor %}

        </div>
      </div>
    </div>

    {# ── Right sidebar ── #}
    <div class="flex-col gap-24">

      {# ── Quick Actions (source : teacher-dashboard.html) ── #}
      <div class="card anim-3">
        <div class="card-head">
          <div class="card-title">Quick Actions</div>
        </div>
        <div class="card-body">
          <div class="quick-actions">
            <a href="{{ path('app_teacher_classes') }}" class="quick-action-btn">
              <i class="fas fa-plus-circle"></i>
              <span>New Class</span>
            </a>
            <a href="{{ path('app_teacher_tasks') }}" class="quick-action-btn">
              <i class="fas fa-file-alt"></i>
              <span>New Assignment</span>
            </a>
            <a href="{{ path('app_teacher_grades') }}" class="quick-action-btn">
              <i class="fas fa-star-half-alt"></i>
              <span>Enter Grades</span>
            </a>
            <a href="{{ path('app_teacher_students') }}" class="quick-action-btn">
              <i class="fas fa-user-plus"></i>
              <span>Add Student</span>
            </a>
          </div>
        </div>
      </div>

      {# ── Recent Activity (source : teacher-dashboard.html — .activity-list) ── #}
      <div class="card anim-4">
        <div class="card-head">
          <div class="card-title">Recent Activity</div>
        </div>
        <div class="activity-list">

          {# TODO Membre 4 : boucler sur recentActivity[]
             Chaque ActivityItem expose : iconBg (style inline), iconFaClass,
             description (HTML, utiliser |raw avec prudence), timeAgo, classCode #}
          {% for item in recentActivity %}
            <div class="activity-item">
              <div class="activity-icon" style="{{ item.iconBg }}">
                <i class="fas {{ item.iconFaClass }}"></i>
              </div>
              <div class="activity-text">
                {# TODO Membre 4 : description contient du HTML (<strong>) — vérifier l'échappement #}
                <p>{{ item.description|raw }}</p>
                <div class="activity-time">{{ item.timeAgo }} · {{ item.classCode }}</div>
              </div>
            </div>
          {% endfor %}

        </div>
      </div>

    </div>{# /right sidebar #}

  </div>{# /dashboard-grid #}

{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/teacher.js') }}"></script>
{% endblock %}