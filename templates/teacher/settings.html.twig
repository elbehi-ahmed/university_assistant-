{% extends 'base.html.twig' %}

{% block title %}Settings{% endblock %}

{% block page_title %}Settings{% endblock %}

{% block page_breadcrumb %}Manage your teacher account{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/teacher-settings.css') }}" />
{% endblock %}

{% block body %}
<div class="page-content">
  <div class="settings-container">

    {# ── Profile Settings ── #}
    <div class="settings-card">
      <div class="settings-card-header">
        <i class="fas fa-user-edit"></i>
        <h2>Profile Information</h2>
      </div>
      <div class="settings-card-body">
        <div class="avatar-upload">
          <div class="avatar-preview">{{ teacher.initials }}</div>
          <div>
            <button class="btn btn-ghost btn-sm" onclick="alert('Avatar upload demo')">
              <i class="fas fa-camera"></i> Change photo
            </button>
            <p class="mt-8" style="font-size: 0.7rem; color: var(--muted)">JPG or PNG, max 2MB</p>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">First name</label>
            <input type="text" class="form-control" id="firstname" value="{{ teacher.prenom }}" />
          </div>
          <div class="form-group">
            <label class="form-label">Last name</label>
            <input type="text" class="form-control" id="lastname" value="{{ teacher.nom }}" />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Email address</label>
          <input type="email" class="form-control" id="email" value="{{ teacher.email }}" />
        </div>
        <div class="form-group">
          <label class="form-label">Department</label>
          <select class="form-control" id="department">
            {% for dept in departments %}
              <option{% if teacher.department == dept %} selected{% endif %}>{{ dept }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
    </div>

    {# ── Change Password ── #}
    <div class="settings-card">
      <div class="settings-card-header">
        <i class="fas fa-lock"></i>
        <h2>Security &amp; Password</h2>
      </div>
      <div class="settings-card-body">
        <div class="form-group">
          <label class="form-label">Current password</label>
          <input type="password" class="form-control" id="current-pw" placeholder="Enter current password" />
        </div>
        <div class="form-group">
          <label class="form-label">New password</label>
          <input type="password" class="form-control" id="new-pw" placeholder="At least 8 characters" />
        </div>
        <div class="form-group">
          <label class="form-label">Confirm new password</label>
          <input type="password" class="form-control" id="confirm-pw" placeholder="Repeat new password" />
        </div>
        <div class="mt-16">
          <button class="btn btn-primary" onclick="changePassword()">Update password</button>
        </div>
      </div>
    </div>

    {# ── Notification Preferences ── #}
    <div class="settings-card">
      <div class="settings-card-header">
        <i class="fas fa-bell"></i>
        <h2>Notification Preferences</h2>
      </div>
      <div class="settings-card-body">
        <div class="toggle-switch">
          <div>
            <div class="toggle-label">New submission alerts</div>
            <div class="toggle-desc">Get notified when a student submits a task</div>
          </div>
          <label class="toggle">
            <input type="checkbox" id="submission-notif" {% if notifications.submissionAlerts %}checked{% endif %} />
            <span class="slider"></span>
          </label>
        </div>
        <div class="toggle-switch">
          <div>
            <div class="toggle-label">Upcoming exam reminders</div>
            <div class="toggle-desc">Receive reminders before scheduled exams</div>
          </div>
          <label class="toggle">
            <input type="checkbox" id="exam-notif" {% if notifications.examReminders %}checked{% endif %} />
            <span class="slider"></span>
          </label>
        </div>
        <div class="toggle-switch">
          <div>
            <div class="toggle-label">Weekly class summary</div>
            <div class="toggle-desc">Receive a summary of class activity every Friday</div>
          </div>
          <label class="toggle">
            <input type="checkbox" id="summary-notif" {% if notifications.weeklySummary %}checked{% endif %} />
            <span class="slider"></span>
          </label>
        </div>
      </div>
    </div>

    {# ── Teaching Preferences ── #}
    <div class="settings-card">
      <div class="settings-card-header">
        <i class="fas fa-chalkboard"></i>
        <h2>Teaching Preferences</h2>
      </div>
      <div class="settings-card-body">
        <div class="form-group">
          <label class="form-label">Default grading scale</label>
          <select class="form-control" id="grading-scale">
            {% for scale in gradingScales %}
              <option{% if preferences.defaultGradingScale == scale %} selected{% endif %}>{{ scale }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="toggle-switch">
          <div>
            <div class="toggle-label">Auto-calculate class average</div>
            <div class="toggle-desc">Display average grades on dashboard</div>
          </div>
          <label class="toggle">
            <input type="checkbox" id="auto-average" {% if preferences.autoCalculateAverage %}checked{% endif %} />
            <span class="slider"></span>
          </label>
        </div>
      </div>
    </div>

    {# ── Save Button ── #}
    <div style="text-align: right; margin-top: 20px">
      <button class="btn-save" onclick="saveAllSettings()">
        <i class="fas fa-save"></i> Save all changes
      </button>
    </div>

  </div>
</div>
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/teacher.js') }}"></script>
{% endblock %}