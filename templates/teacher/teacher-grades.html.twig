<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>UniAssistant — Grades</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="shared.css" />
  <style>
    /* ── Grade layout ── */
    .grade-layout {
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: 24px;
      align-items: start;
    }

    @media (max-width:1100px) { .grade-layout { grid-template-columns:1fr; } }

    /* Assignment selector list */
    .assignment-list { display:flex; flex-direction:column; gap:0; }

    .assignment-item {
      padding:14px 20px;
      border-bottom:1px solid rgba(201,168,76,0.06);
      cursor:pointer;
      transition:background var(--transition);
      display:flex; flex-direction:column; gap:5px;
    }
    .assignment-item:last-child { border-bottom:none; }
    .assignment-item:hover { background:rgba(201,168,76,0.05); }
    .assignment-item.active { background:rgba(201,168,76,0.1); border-left:3px solid var(--gold); padding-left:17px; }

    .ai-title { font-size:0.875rem; font-weight:600; color:var(--white); }
    .ai-meta  { font-size:0.75rem; color:var(--muted); display:flex; gap:10px; }
    .ai-meta span { display:flex; align-items:center; gap:4px; }
    .ai-meta i { font-size:0.7rem; color:var(--gold); }

    /* Grade table */
    .grade-input {
      width: 70px;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(201,168,76,0.2);
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 0.9rem;
      color: var(--white);
      font-family: 'DM Sans', sans-serif;
      outline: none;
      text-align: center;
      transition: all var(--transition);
    }
    .grade-input:focus { border-color:var(--gold); background:rgba(201,168,76,0.08); box-shadow:0 0 0 3px rgba(201,168,76,0.1); }
    .grade-input.saved { border-color:rgba(76,175,130,0.5); background:rgba(76,175,130,0.07); }

    .grade-letter {
      font-family:'Playfair Display',serif;
      font-size:1rem;
      font-weight:700;
      min-width:28px;
      text-align:center;
    }
    .grade-letter.A  { color:#6fd4a8; }
    .grade-letter.B  { color:#82b8f0; }
    .grade-letter.C  { color:var(--gold-light); }
    .grade-letter.D  { color:var(--warning); }
    .grade-letter.F  { color:var(--danger); }
    .grade-letter.na { color:var(--muted); font-size:0.8rem; }

    .student-name-cell { display:flex; align-items:center; gap:10px; }
    .student-avatar-sm {
      width:30px; height:30px;
      border-radius:50%;
      background: linear-gradient(135deg,var(--gold-dim),var(--gold));
      display:flex; align-items:center; justify-content:center;
      font-family:'Playfair Display',serif;
      font-size:0.75rem;
      color:var(--navy);
      font-weight:700;
      flex-shrink:0;
    }

    .save-row-btn {
      width:30px; height:30px;
      border-radius:6px;
      background:rgba(76,175,130,0.12);
      border:1px solid rgba(76,175,130,0.25);
      color:var(--success);
      display:flex; align-items:center; justify-content:center;
      cursor:pointer; font-size:0.8rem;
      transition:all var(--transition);
    }
    .save-row-btn:hover { background:rgba(76,175,130,0.22); }

    /* Stats row at top */
    .grade-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:20px; }

    .gs-card {
      background:rgba(255,255,255,0.04);
      border:1px solid var(--border-dim);
      border-radius:var(--radius-md);
      padding:14px 16px;
      text-align:center;
    }
    .gs-val { font-family:'Playfair Display',serif; font-size:1.4rem; font-weight:700; color:var(--white); }
    .gs-lbl { font-size:0.68rem; color:var(--muted); text-transform:uppercase; letter-spacing:0.07em; margin-top:3px; }

    .bulk-bar { display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:16px; }
    .bulk-bar span { font-size:0.8rem; color:var(--muted); }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">
    <a class="sidebar-brand" href="teacher-dashboard.html">
      <div class="sidebar-logo"><img src="" alt="" onerror="this.style.display='none';this.parentElement.innerHTML='<i class=\'fas fa-graduation-cap\' style=\'color:var(--gold);font-size:1.2rem;\'></i>'"/></div>
      <div class="sidebar-brand-text">
        <div class="sidebar-brand-name">Uni<span>Assistant</span></div>
        <div class="sidebar-brand-sub">Academic Platform</div>
      </div>
    </a>
    <div class="teacher-badge-sidebar"><i class="fas fa-chalkboard-teacher"></i> Teacher Portal</div>
    <nav class="sidebar-nav">
      <div class="nav-section-label">Main</div>
      <a class="nav-link" href="teacher-dashboard.html"><i class="fas fa-th-large"></i>Dashboard</a>
      <a class="nav-link" href="teacher-classes.html"><i class="fas fa-door-open"></i>My Classes <span class="nav-badge gold">5</span></a>
      <a class="nav-link" href="teacher-tasks.html"><i class="fas fa-tasks"></i>Assignments <span class="nav-badge">8</span></a>
      <a class="nav-link active" href="teacher-grades.html"><i class="fas fa-star-half-alt"></i>Grades</a>
      <a class="nav-link" href="teacher-students.html"><i class="fas fa-users"></i>Students</a>
      <div class="nav-section-label">Account</div>
      <a class="nav-link" href="#"><i class="fas fa-user-circle"></i>Profile</a>
      <a class="nav-link" href="#"><i class="fas fa-cog"></i>Settings</a>
    </nav>
    <div class="sidebar-footer">
      <div class="user-avatar">S</div>
      <div class="user-info">
        <div class="user-name">Dr. Sarah Mansouri</div>
        <div class="user-role">TEACHER</div>
      </div>
      <a href="#" class="btn-logout" data-tip="Logout"><i class="fas fa-sign-out-alt"></i></a>
    </div>
  </aside>

  <div class="main-wrap">
    <div class="topbar">
      <div class="topbar-left">
        <div class="page-title">Grades & Evaluation</div>
        <div class="page-breadcrumb"><span>Dashboard</span> / Grades</div>
      </div>
      <div class="topbar-right">
        <button class="mobile-menu-btn" onclick="document.getElementById('sidebar').classList.toggle('open')"><i class="fas fa-bars"></i></button>
        <a class="topbar-icon-btn" href="#"><i class="fas fa-bell"></i><span class="notif-dot"></span></a>
      </div>
    </div>

    <div class="page-content">

      <!-- Filter bar -->
      <div class="flex items-center gap-12 mb-24 anim-1" style="flex-wrap:wrap">
        <select class="form-control" style="width:auto" onchange="loadAssignments(this.value)">
          <option>MATH-301 — Advanced Mathematics</option>
          <option>PHYS-210 — Physics Mechanics</option>
          <option>CS-402 — Algorithms & Data Str.</option>
        </select>
        <button class="btn btn-ghost btn-sm"><i class="fas fa-file-export"></i> Export CSV</button>
        <button class="btn btn-ghost btn-sm"><i class="fas fa-print"></i> Print Report</button>
      </div>

      <div class="grade-layout anim-2">

        <!-- Left: assignment list -->
        <div class="card" style="overflow:hidden">
          <div class="card-head">
            <div class="card-title">Assignments</div>
            <span class="badge badge-gold">5 total</span>
          </div>
          <div class="assignment-list">
            <div class="assignment-item active" onclick="selectAssignment(this,'Integration Homework','20')">
              <div class="ai-title">Integration Homework</div>
              <div class="ai-meta">
                <span><i class="fas fa-trophy"></i>20 pts</span>
                <span><i class="fas fa-users"></i>32 students</span>
              </div>
            </div>
            <div class="assignment-item" onclick="selectAssignment(this,'Derivatives Quiz','15')">
              <div class="ai-title">Derivatives Quiz</div>
              <div class="ai-meta">
                <span><i class="fas fa-trophy"></i>15 pts</span>
                <span><i class="fas fa-users"></i>32 students</span>
              </div>
            </div>
            <div class="assignment-item" onclick="selectAssignment(this,'Midterm Exam','60')">
              <div class="ai-title">Midterm Exam</div>
              <div class="ai-meta">
                <span><i class="fas fa-trophy"></i>60 pts</span>
                <span><i class="fas fa-users"></i>32 students</span>
              </div>
            </div>
            <div class="assignment-item" onclick="selectAssignment(this,'Series Homework','20')">
              <div class="ai-title">Series Homework</div>
              <div class="ai-meta">
                <span><i class="fas fa-trophy"></i>20 pts</span>
                <span><i class="fas fa-users"></i>32 students</span>
              </div>
            </div>
            <div class="assignment-item" onclick="selectAssignment(this,'Final Project','100')">
              <div class="ai-title">Final Project</div>
              <div class="ai-meta">
                <span><i class="fas fa-trophy"></i>100 pts</span>
                <span><i class="fas fa-users"></i>32 students</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: grade table -->
        <div class="flex-col gap-16">

          <!-- Stats -->
          <div class="grade-stats anim-3">
            <div class="gs-card"><div class="gs-val" id="avg-val">14.2</div><div class="gs-lbl">Class Average</div></div>
            <div class="gs-card"><div class="gs-val" id="high-val">19</div><div class="gs-lbl">Highest</div></div>
            <div class="gs-card"><div class="gs-val" id="low-val">7</div><div class="gs-lbl">Lowest</div></div>
            <div class="gs-card"><div class="gs-val" id="graded-val">21/32</div><div class="gs-lbl">Graded</div></div>
          </div>

          <div class="card anim-3">
            <div class="card-head">
              <div>
                <div class="card-title" id="assignment-title">Integration Homework</div>
                <div style="font-size:0.75rem;color:var(--muted);margin-top:3px">Max points: <span id="max-pts">20</span> pts</div>
              </div>
              <div class="flex gap-8">
                <button class="btn btn-ghost btn-sm" onclick="saveAllGrades()"><i class="fas fa-save"></i> Save All</button>
                <button class="btn btn-primary btn-sm" onclick="publishGrades()"><i class="fas fa-paper-plane"></i> Publish</button>
              </div>
            </div>

            <div class="card-body" style="padding-top:16px;padding-bottom:0">
              <div class="bulk-bar">
                <span>Bulk actions:</span>
                <button class="btn btn-ghost btn-sm" onclick="fillAbsent()"><i class="fas fa-user-slash"></i> Mark absent as 0</button>
                <button class="btn btn-ghost btn-sm" onclick="sortByGrade()"><i class="fas fa-sort-amount-down"></i> Sort by grade</button>
              </div>
            </div>

            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Student</th>
                    <th>Points</th>
                    <th>/ Max</th>
                    <th>Letter</th>
                    <th>Feedback</th>
                    <th>Save</th>
                  </tr>
                </thead>
                <tbody id="grades-body">
                  <!-- Rows generated by JS -->
                </tbody>
              </table>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- Feedback modal -->
  <div class="modal-overlay" id="modal-overlay">
    <div class="modal" style="max-width:440px">
      <div class="modal-head">
        <div class="modal-title">Add Feedback — <span id="feedback-student-name">Student</span></div>
        <button class="modal-close" onclick="closeModal()"><i class="fas fa-times"></i></button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Comment / Feedback</label>
          <textarea class="form-control" id="feedback-text" placeholder="Write feedback for this student…" style="min-height:120px"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
        <button class="btn btn-primary" onclick="saveFeedback()"><i class="fas fa-save"></i> Save</button>
      </div>
    </div>
  </div>

  <script>
    const STUDENTS = [
      {id:1, name:'Ahmed Ben Ali',     init:'A'},
      {id:2, name:'Yassine Boukhari',  init:'Y'},
      {id:3, name:'Amina Khalil',      init:'A'},
      {id:4, name:'Sarra Hamdi',       init:'S'},
      {id:5, name:'Mounir Trabelsi',   init:'M'},
      {id:6, name:'Rania Kchaou',      init:'R'},
      {id:7, name:'Bilel Gharbi',      init:'B'},
      {id:8, name:'Ines Turki',        init:'I'},
      {id:9, name:'Hatem Karray',      init:'H'},
      {id:10,name:'Nour Bousbia',      init:'N'},
      {id:11,name:'Skander Mejri',     init:'S'},
      {id:12,name:'Leila Ayari',       init:'L'},
    ];

    let currentMax = 20;
    let feedbackCurrentRow = null;

    function getLetterClass(score, max) {
      const pct = (score / max) * 20;
      if (pct >= 16) return 'A';
      if (pct >= 13) return 'B';
      if (pct >= 10) return 'C';
      if (pct >= 7)  return 'D';
      return 'F';
    }

    function renderTable() {
      const tbody = document.getElementById('grades-body');
      tbody.innerHTML = STUDENTS.map((s,i) => {
        const score = i < 7 ? Math.floor(Math.random()*8 + 12) : '';
        const letter = score !== '' ? getLetterClass(score, currentMax) : 'na';
        return `
        <tr id="row-${s.id}">
          <td>
            <div class="student-name-cell">
              <div class="student-avatar-sm">${s.init}</div>
              ${s.name}
            </div>
          </td>
          <td>
            <input class="grade-input${score!==''?' saved':''}" type="number" min="0" max="${currentMax}"
              value="${score}" id="grade-${s.id}"
              onchange="updateLetter(${s.id},${currentMax})"
              oninput="this.classList.remove('saved')"
            />
          </td>
          <td style="color:var(--muted);font-size:0.82rem">/ ${currentMax}</td>
          <td><span class="grade-letter ${letter}" id="letter-${s.id}">${score!==''?letter:'—'}</span></td>
          <td>
            <button class="btn btn-icon btn-ghost" data-tip="Add feedback" onclick="openFeedback(${s.id},'${s.name}')"><i class="fas fa-comment-alt"></i></button>
          </td>
          <td>
            <button class="save-row-btn" data-tip="Save" onclick="saveRow(${s.id})"><i class="fas fa-check"></i></button>
          </td>
        </tr>`;
      }).join('');
    }

    function updateLetter(id, max) {
      const val = parseFloat(document.getElementById('grade-'+id).value);
      const el  = document.getElementById('letter-'+id);
      if (isNaN(val)) { el.textContent='—'; el.className='grade-letter na'; return; }
      const letter = getLetterClass(val, max);
      el.textContent = letter;
      el.className   = 'grade-letter ' + letter;
    }

    function saveRow(id) {
      const input = document.getElementById('grade-'+id);
      input.classList.add('saved');
    }

    function saveAllGrades() {
      document.querySelectorAll('.grade-input').forEach(i => i.classList.add('saved'));
    }

    function publishGrades() {
      saveAllGrades();
      alert('Grades published! Students will be notified.');
    }

    function fillAbsent() {
      document.querySelectorAll('.grade-input').forEach((input, i) => {
        if (input.value === '') { input.value = 0; const sid = STUDENTS[i].id; updateLetter(sid, currentMax); }
      });
    }

    function sortByGrade() {
      const tbody = document.getElementById('grades-body');
      const rows = Array.from(tbody.querySelectorAll('tr'));
      rows.sort((a,b) => {
        const va = parseFloat(a.querySelector('.grade-input').value)||0;
        const vb = parseFloat(b.querySelector('.grade-input').value)||0;
        return vb - va;
      });
      rows.forEach(r => tbody.appendChild(r));
    }

    function openFeedback(id, name) {
      feedbackCurrentRow = id;
      document.getElementById('feedback-student-name').textContent = name;
      document.getElementById('feedback-text').value = '';
      document.getElementById('modal-overlay').classList.add('open');
    }

    function saveFeedback() { closeModal(); }
    function closeModal() { document.getElementById('modal-overlay').classList.remove('open'); }

    function selectAssignment(el, title, max) {
      document.querySelectorAll('.assignment-item').forEach(i => i.classList.remove('active'));
      el.classList.add('active');
      document.getElementById('assignment-title').textContent = title;
      document.getElementById('max-pts').textContent = max;
      currentMax = parseInt(max);
      renderTable();
    }

    document.getElementById('modal-overlay').addEventListener('click', e => {
      if (e.target === document.getElementById('modal-overlay')) closeModal();
    });

    renderTable();
  </script>
</body>
</html>