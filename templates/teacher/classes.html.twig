{#
  templates/teacher/classes.html.twig

  TODO Membre 4 : Ce Controller (TeacherClassesController) doit passer les variables suivantes :
    - classes (array of objects) : liste des classes du professeur connecté.
        Chaque objet doit avoir :
          · id (int)
          · name (string)          ex: "Advanced Mathematics"
          · code (string)          ex: "MATH-301"
          · semester (string)      ex: "Semester 3"
          · category (string)      ex: "math" | "physics" | "cs" | "chem" | "english"
          · icon (string)          ex: "fa-square-root-alt"
          · description (string)
          · studentCount (int)
          · assignmentCount (int)
          · avgGrade (float)       ex: 14.2
          · curriculumProgress (int) ex: 68  (percentage 0–100)
          · schedule (string)      ex: "Mon, Wed 08:00–10:00"
    - semesters (array of strings) : liste des semestres disponibles ex: ["Sem 1","Sem 2","Sem 3","Sem 4"]
    - activeClassCount (int) : nombre de classes actives — utilisé par la sidebar via base.html.twig
#}

{% extends 'base.html.twig' %}

{% block title %}My Classes{% endblock %}

{% block page_title %}My Classes{% endblock %}

{% block page_breadcrumb %}<span>Dashboard</span> / My Classes{% endblock %}

{% block stylesheets %}
<style>
  /* ── Classes Grid ── */
  .classes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }

  .class-card {
    background: linear-gradient(
      145deg,
      rgba(30, 48, 74, 0.9),
      rgba(22, 34, 54, 0.95)
    );
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      transform var(--transition),
      box-shadow var(--transition),
      border-color var(--transition);
  }
  .class-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-deep);
    border-color: var(--border);
  }

  .class-card-banner {
    height: 7px;
    width: 100%;
  }
  .banner-math    { background: linear-gradient(90deg, var(--gold-dim), var(--gold)); }
  .banner-physics { background: linear-gradient(90deg, #2a6abf, var(--info)); }
  .banner-cs      { background: linear-gradient(90deg, #2e8b57, var(--success)); }
  .banner-chem    { background: linear-gradient(90deg, #b87c2a, var(--warning)); }
  .banner-english { background: linear-gradient(90deg, #b03030, var(--danger)); }

  .class-card-body { padding: 22px; }

  .class-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .class-icon-wrap {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
  }
  .class-icon-wrap.math    { background: rgba(201,168,76,0.15); color: var(--gold); }
  .class-icon-wrap.physics { background: rgba(76,143,224,0.15); color: var(--info); }
  .class-icon-wrap.cs      { background: rgba(76,175,130,0.15); color: var(--success); }
  .class-icon-wrap.chem    { background: rgba(224,168,76,0.15); color: var(--warning); }
  .class-icon-wrap.english { background: rgba(224,92,92,0.15);  color: var(--danger); }

  .class-actions { display: flex; gap: 6px; }

  .class-name {
    font-family: "Playfair Display", serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 4px;
  }
  .class-code {
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .class-desc {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .class-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 16px;
  }

  .class-stat {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    padding: 10px;
    text-align: center;
  }
  .class-stat-val {
    font-family: "Playfair Display", serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--white);
  }
  .class-stat-lbl {
    font-size: 0.65rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-top: 2px;
  }

  .class-progress-row { margin-bottom: 14px; }
  .class-progress-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
    font-size: 0.75rem;
  }
  .class-progress-meta span   { color: var(--muted); }
  .class-progress-meta strong { color: var(--gold-light); }

  .class-card-footer {
    padding: 14px 22px;
    border-top: 1px solid var(--border-dim);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .class-schedule {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .class-schedule i { color: var(--gold); font-size: 0.75rem; }

  /* Add class card */
  .add-class-card {
    background: rgba(201,168,76,0.04);
    border: 2px dashed rgba(201,168,76,0.25);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 280px;
    cursor: pointer;
    transition: all var(--transition);
    text-decoration: none;
  }
  .add-class-card:hover {
    background: rgba(201,168,76,0.08);
    border-color: var(--gold);
    transform: translateY(-3px);
  }
  .add-class-card i    { font-size: 2rem; color: rgba(201,168,76,0.5); }
  .add-class-card span { font-size: 0.9rem; color: var(--muted); font-weight: 500; }

  /* Modal wide */
  .modal { max-width: 600px; }

  /* Color picker for class */
  .color-picker-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .color-dot {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .color-dot.selected { border-color: var(--white); transform: scale(1.15); }
  .color-dot i          { font-size: 0.7rem; color: #fff; display: none; }
  .color-dot.selected i { display: block; }
</style>
{% endblock %}

{% block body %}
<div class="page-content">

  {# ── Toolbar ── #}
  <div class="flex items-center justify-between mb-24 anim-1" style="flex-wrap: wrap; gap: 12px">
    <div class="search-wrap">
      <i class="fas fa-search search-icon"></i>
      <input
        class="search-input"
        type="text"
        placeholder="Search classes…"
        oninput="filterClasses(this.value)"
      />
    </div>
    <div class="flex gap-8">
      <select class="form-control" style="width: auto; padding: 9px 14px">
        <option value="">All semesters</option>
        {# TODO Membre 4 : itérer sur la variable semesters #}
        {% for semester in semesters|default([]) %}
          <option value="{{ semester }}">{{ semester }}</option>
        {% endfor %}
      </select>
      <button class="btn btn-primary" onclick="openModal()">
        <i class="fas fa-plus"></i> New Class
      </button>
    </div>
  </div>

  {# ── Classes grid ── #}
  {# TODO Membre 4 : itérer sur la variable classes #}
  <div class="classes-grid anim-2" id="classes-grid">

    {% for class in classes|default([]) %}
    <div class="class-card" data-name="{{ class.name|default('Unknown Class') }}">
      <div class="class-card-banner banner-{{ class.category|default('math') }}"></div>
      <div class="class-card-body">
        <div class="class-header">
          <div style="display: flex; gap: 14px; align-items: flex-start">
            <div class="class-icon-wrap {{ class.category|default('math') }}">
              <i class="fas {{ class.icon|default('fa-book') }}"></i>
            </div>
            <div>
              <div class="class-name">{{ class.name|default('Unknown Class') }}</div>
              <div class="class-code">{{ class.code|default('N/A') }} · {{ class.semester|default('N/A') }}</div>
            </div>
          </div>
          <div class="class-actions">
            <button
              class="btn btn-icon btn-ghost"
              data-tip="Edit"
              onclick="openEditModal('{{ class.name|default('Unknown Class')|escape('js') }}')"
            >
              <i class="fas fa-pen"></i>
            </button>
            <button
              class="btn btn-icon btn-danger"
              data-tip="Delete"
              onclick="deleteClass(this)"
            >
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </div>

        <p class="class-desc">{{ class.description|default('No description provided.') }}</p>

        <div class="class-stats">
          <div class="class-stat">
            <div class="class-stat-val">{{ class.studentCount|default(0) }}</div>
            <div class="class-stat-lbl">Students</div>
          </div>
          <div class="class-stat">
            <div class="class-stat-val">{{ class.assignmentCount|default(0) }}</div>
            <div class="class-stat-lbl">Assignments</div>
          </div>
          <div class="class-stat">
            <div class="class-stat-val">{{ class.avgGrade|default('-') }}</div>
            <div class="class-stat-lbl">Avg. Grade</div>
          </div>
        </div>

        <div class="class-progress-row">
          <div class="class-progress-meta">
            <span>Curriculum progress</span>
            <strong>{{ class.curriculumProgress|default(0) }}%</strong>
          </div>
          <div class="progress-wrap">
            <div class="progress-bar{% if (class.curriculumProgress|default(0)) >= 80 %} success{% endif %}" style="width: {{ class.curriculumProgress|default(0) }}%"></div>
          </div>
        </div>
      </div>

      <div class="class-card-footer">
        <div class="class-schedule">
          <i class="fas fa-clock"></i>{{ class.schedule|default('TBD') }}
        </div>
        <a href="{{ path('app_teacher_tasks') }}" class="btn btn-primary btn-sm">
          <i class="fas fa-tasks"></i>Tasks
        </a>
      </div>
    </div>
    {% else %}
    {# Cas où aucune classe n'existe encore #}
    {% endfor %}

    {# ── Add new class card ── #}
    <button class="add-class-card" onclick="openModal()">
      <i class="fas fa-plus-circle"></i>
      <span>Create New Class</span>
    </button>

  </div>
</div>

{# ── Create Class Modal ── #}
<div class="modal-overlay" id="modal-overlay">
  <div class="modal">
    <div class="modal-head">
      <div class="modal-title" id="modal-title-text">Create New Class</div>
      <button class="modal-close" onclick="closeModal()">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="modal-body">
      <div class="grid-2">
        <div class="form-group" style="grid-column: 1/-1">
          <label class="form-label">Class Name</label>
          <input class="form-control" type="text" placeholder="e.g. Advanced Mathematics" />
        </div>
        <div class="form-group">
          <label class="form-label">Course Code</label>
          <input class="form-control" type="text" placeholder="e.g. MATH-301" />
        </div>
        <div class="form-group">
          <label class="form-label">Semester</label>
          <select class="form-control">
            <option>Semester 1</option>
            <option>Semester 2</option>
            <option>Semester 3</option>
            <option>Semester 4</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Subject Category</label>
          <select class="form-control">
            <option>Mathematics</option>
            <option>Physics</option>
            <option>Computer Science</option>
            <option>Chemistry</option>
            <option>English</option>
            <option>Other</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Max Students</label>
          <input class="form-control" type="number" placeholder="e.g. 35" min="1" max="200" />
        </div>
        <div class="form-group" style="grid-column: 1/-1">
          <label class="form-label">Schedule (Days &amp; Time)</label>
          <input class="form-control" type="text" placeholder="e.g. Mon, Wed 08:00–10:00" />
        </div>
        <div class="form-group" style="grid-column: 1/-1">
          <label class="form-label">Description</label>
          <textarea class="form-control" placeholder="Brief description of what students will learn…"></textarea>
        </div>
        <div class="form-group" style="grid-column: 1/-1">
          <label class="form-label">Class Color</label>
          <div class="color-picker-row">
            <div class="color-dot selected" style="background: #c9a84c" onclick="selectColor(this)"><i class="fas fa-check"></i></div>
            <div class="color-dot" style="background: #4c8fe0" onclick="selectColor(this)"><i class="fas fa-check"></i></div>
            <div class="color-dot" style="background: #4caf82" onclick="selectColor(this)"><i class="fas fa-check"></i></div>
            <div class="color-dot" style="background: #e0a84c" onclick="selectColor(this)"><i class="fas fa-check"></i></div>
            <div class="color-dot" style="background: #e05c5c" onclick="selectColor(this)"><i class="fas fa-check"></i></div>
            <div class="color-dot" style="background: #9b59b6" onclick="selectColor(this)"><i class="fas fa-check"></i></div>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-primary" onclick="saveClass()">
        <i class="fas fa-save"></i> Save Class
      </button>
    </div>
  </div>
</div>
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/teacher.js') }}"></script>
{% endblock %}