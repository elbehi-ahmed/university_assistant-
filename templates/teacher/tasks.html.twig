{% extends 'base.html.twig' %}

{% block title %}Assignments{% endblock %}

{% block page_title %}Assignments &amp; Tasks{% endblock %}

{% block page_breadcrumb %}<span>Dashboard</span> / Assignments{% endblock %}

{% block stylesheets %}
<style>
  /* ── Task row enhancements ── */
  .task-title-cell { display: flex; flex-direction: column; gap: 3px; }
  .task-title    { font-size: 0.9rem; font-weight: 600; color: var(--white); }
  .task-subtitle { font-size: 0.78rem; color: var(--muted); }

  .deadline-cell { display: flex; align-items: center; gap: 7px; font-size: 0.845rem; }
  .deadline-cell.overdue { color: var(--danger); }
  .deadline-cell.soon    { color: var(--warning); }
  .deadline-cell.ok      { color: var(--muted-less); }

  .submissions-bar { display: flex; align-items: center; gap: 10px; }
  .submissions-bar .num { font-size: 0.82rem; color: var(--white); min-width: 40px; }
  .progress-wrap { flex: 1; min-width: 80px; }

  .filter-bar { display: flex; gap: 8px; flex-wrap: wrap; }
  .filter-select {
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--border-dim);
    border-radius: var(--radius-sm);
    padding: 9px 14px;
    font-size: 0.845rem;
    color: var(--white);
    font-family: "DM Sans", sans-serif;
    outline: none;
    transition: border-color var(--transition);
    cursor: pointer;
  }
  .filter-select:focus  { border-color: var(--gold); }
  .filter-select option { background: var(--navy-mid); }

  .action-btns { display: flex; gap: 6px; }

  /* attachment preview in modal */
  .attachment-zone {
    border: 2px dashed rgba(201,168,76,0.25);
    border-radius: var(--radius-md);
    padding: 24px;
    text-align: center;
    cursor: pointer;
    transition: all var(--transition);
  }
  .attachment-zone:hover { border-color: var(--gold); background: rgba(201,168,76,0.04); }
  .attachment-zone i    { font-size: 1.6rem; color: rgba(201,168,76,0.4); margin-bottom: 8px; display: block; }
  .attachment-zone span { font-size: 0.82rem; color: var(--muted); }

  /* Points badge */
  .pts-badge {
    background: rgba(201,168,76,0.12);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 2px 10px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--gold-light);
  }
</style>
{% endblock %}

{% block body %}
<div class="page-content">

  {# ── Toolbar ── #}
  <div class="flex items-center justify-between mb-24 anim-1" style="flex-wrap: wrap; gap: 12px">
    <div class="flex gap-8 items-center" style="flex-wrap: wrap">
      <div class="search-wrap">
        <i class="fas fa-search search-icon"></i>
        <input
          class="search-input"
          type="text"
          placeholder="Search assignments…"
          oninput="filterTasks(this.value)"
        />
      </div>
      <select class="filter-select" onchange="filterByStatus(this.value)">
        <option value="">All statuses</option>
        <option value="open">Open</option>
        <option value="closed">Closed</option>
        <option value="draft">Draft</option>
      </select>
      <select class="filter-select" onchange="filterByClass(this.value)">
        <option value="">All classes</option>
        {% for cls in classesList|default([]) %}
          <option value="{{ cls.value|default('') }}">{{ cls.code|default('') }}</option>
        {% endfor %}
      </select>
    </div>
    <button class="btn btn-primary" onclick="openModal()">
      <i class="fas fa-plus"></i> New Assignment
    </button>
  </div>

  {# ── Tabs ── #}
  <div class="flex items-center gap-16 mb-24 anim-1" style="flex-wrap: wrap">
    <div class="tab-bar" id="status-tabs">
      <button class="tab-btn active" onclick="switchTab(this, 'all')">
        All
        <span style="opacity: 0.6; font-size: 0.8em; margin-left: 4px">{{ totalCount|default(0) }}</span>
      </button>
      <button class="tab-btn" onclick="switchTab(this, 'open')">
        Open
        <span style="opacity: 0.6; font-size: 0.8em; margin-left: 4px">{{ openCount|default(0) }}</span>
      </button>
      <button class="tab-btn" onclick="switchTab(this, 'pending')">
        Pending Review
        <span style="opacity: 0.6; font-size: 0.8em; margin-left: 4px">{{ pendingCount|default(0) }}</span>
      </button>
      <button class="tab-btn" onclick="switchTab(this, 'closed')">
        Closed
      </button>
    </div>
  </div>

  {# ── Table ── #}
  <div class="card anim-2">
    <div class="table-wrap">
      <table id="tasks-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Class</th>
            <th>Deadline</th>
            <th>Points</th>
            <th>Priority</th>
            <th>Submissions</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="tasks-body">
          {% for task in tasks|default([]) %}
          <tr data-name="{{ task.title|default('') }}" data-status="{{ task.status|default('') }}">
            <td>
              <div class="task-title-cell">
                <span class="task-title">{{ task.title|default('Untitled') }}</span>
                <span class="task-subtitle">{{ task.subtitle|default('') }}</span>
              </div>
            </td>
            <td>
              <span class="badge {{ task.classBadgeClass|default('') }}">{{ task.classCode|default('') }}</span>
            </td>
            <td>
              <div class="deadline-cell {{ task.deadlineClass|default('') }}">
                <i class="fas fa-clock"></i>{{ task.deadline|default('—') }}
              </div>
            </td>
            <td><span class="pts-badge">{{ task.maxPoints|default(0) }} pts</span></td>
            <td>
              <span class="badge {{ task.priorityBadgeClass|default('') }}">{{ task.priority|default('') }}</span>
            </td>
            <td>
              <div class="submissions-bar">
                <span class="num">{{ task.submittedCount|default(0) }}/{{ task.totalCount|default(0) }}</span>
                <div class="progress-wrap">
                  <div class="progress-bar {% if task.submissionBarClass|default('') %}{{ task.submissionBarClass }}{% endif %}" style="width: {{ task.submissionPercent|default(0) }}%"></div>
                </div>
              </div>
            </td>
            <td>
              <span class="badge {{ task.statusBadgeClass|default('') }}">{{ task.statusLabel|default('') }}</span>
            </td>
            <td>
              <div class="action-btns">
                <button class="btn btn-icon btn-ghost" data-tip="View submissions">
                  <i class="fas fa-eye"></i>
                </button>
                <button
                  class="btn btn-icon btn-ghost"
                  data-tip="Edit"
                  onclick="openEditModal('{{ task.title|default('') }}')"
                >
                  <i class="fas fa-pen"></i>
                </button>
                <button class="btn btn-icon btn-danger" data-tip="Delete">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </td>
          </tr>
          {% else %}
          <tr>
            <td colspan="8" style="text-align: center; color: var(--muted); padding: 32px">
              No assignments found.
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</div>

{# ── Create Assignment Modal ── #}
<div class="modal-overlay" id="modal-overlay">
  <div class="modal">
    <div class="modal-head">
      <div class="modal-title" id="modal-title-text">New Assignment</div>
      <button class="modal-close" onclick="closeModal()">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="modal-body">
      <div class="grid-2">
        <div class="form-group" style="grid-column: 1/-1">
          <label class="form-label">Assignment Title</label>
          <input class="form-control" type="text" placeholder="e.g. Integration Homework" />
        </div>
        <div class="form-group" style="grid-column: 1/-1">
          <label class="form-label">Description / Instructions</label>
          <textarea class="form-control" placeholder="Describe what students need to do…"></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Class</label>
          <select class="form-control">
            {% for cls in classesList|default([]) %}
              <option value="{{ cls.value|default('') }}">{{ cls.code|default('') }}{% if cls.name is defined %} — {{ cls.name }}{% endif %}</option>
            {% endfor %}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Priority</label>
          <select class="form-control">
            <option>High</option>
            <option>Medium</option>
            <option>Low</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Deadline</label>
          <input class="form-control" type="date" />
        </div>
        <div class="form-group">
          <label class="form-label">Max Points</label>
          <input class="form-control" type="number" placeholder="e.g. 20" min="1" max="100" />
        </div>
        <div class="form-group" style="grid-column: 1/-1">
          <label class="form-label">Attachment (optional)</label>
          <div class="attachment-zone" onclick="this.querySelector('input').click()">
            <i class="fas fa-cloud-upload-alt"></i>
            <span>Click to upload or drag a file here</span>
            <input type="file" style="display: none" />
          </div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-ghost" onclick="closeModal()">
        <i class="fas fa-save"></i> Save Draft
      </button>
      <button class="btn btn-primary" onclick="saveTask()">
        <i class="fas fa-paper-plane"></i> Publish
      </button>
    </div>
  </div>
</div>
{% endblock %}