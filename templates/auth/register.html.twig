<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UniAssistant — Register</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    
    {# Appel du CSS #}
    <link rel="stylesheet" href="{{ asset('css/register.css') }}" />
  </head>
  <body>
    <div class="geo-accent"></div>
    <div class="geo-accent2"></div>

    <div class="page-wrapper">
      <header>
        <div class="logo-group">
          <div class="logo-ring">
            {# Appel de l'image #}
            <img src="{{ asset('images/insat_logo_round.png') }}" alt="INSAT Logo" />
          </div>
          <div>
            <div class="brand-name">Uni<span>Assistant</span></div>
            <div class="brand-tagline">Intelligent Academic Platform</div>
          </div>
        </div>
        <nav class="header-nav">
          <a href="#">About</a>
          <a href="#">Help</a>
          <a href="{{ path('app_login') }}">Sign in</a>
        </nav>
      </header>

      <section class="hero">
        <div class="hero-badge">
          <i class="fas fa-user-graduate"></i>
          Join UniAssistant
        </div>
        <h1>Start your<br /><em>academic journey</em></h1>
        <p class="hero-desc">
          Create your free account and get instant access to smart task
          management, exam scheduling, and personalised academic insights.
        </p>
        <ul class="feature-list">
          <li class="feature-item"><span class="feature-dot"></span>Free for all INSAT students</li>
          <li class="feature-item"><span class="feature-dot"></span>Secure login with Symfony Security</li>
          <li class="feature-item"><span class="feature-dot"></span>Personalised dashboard from day one</li>
          <li class="feature-item"><span class="feature-dot"></span>No credit card required</li>
        </ul>
      </section>

      <div class="register-col">
        <div class="register-card">
          <div class="card-header">
            <h2>Create account</h2>
            <p>Fill in the details below to get started</p>
            <div class="gold-line"></div>
          </div>

          {# TODO Membre 1 : Ajouter la route app_register dans l'action du form et gérer la sécurité #}
          <form action="" method="post" id="register-form">
            <div class="field-group">
              <div class="field-row">
                <div class="field">
                  <label for="firstname">First name</label>
                  <div class="field-inner">
                    <i class="fas fa-user field-icon"></i>
                    <input id="firstname" type="text" name="firstname" placeholder="Ahmed" required />
                  </div>
                </div>
                <div class="field">
                  <label for="lastname">Last name</label>
                  <div class="field-inner">
                    <i class="fas fa-user field-icon"></i>
                    <input id="lastname" type="text" name="lastname" placeholder="Ben Ali" required />
                  </div>
                </div>
              </div>

              <div class="field">
                <label for="email">University email</label>
                <div class="field-inner">
                  <i class="fas fa-envelope field-icon"></i>
                  <input id="email" type="email" name="email" placeholder="username@insat.ucar.tn" maxlength="80" required />
                </div>
              </div>

              <div class="field">
                <label for="password">Password</label>
                <div class="field-inner">
                  <i class="fas fa-lock field-icon"></i>
                  <input id="password" type="password" name="password" placeholder="Minimum 8 characters" required />
                  <button type="button" class="toggle-pw" onclick="togglePw('password', 'icon-pw1')" aria-label="Toggle password">
                    <i class="fas fa-eye" id="icon-pw1"></i>
                  </button>
                </div>
                <div class="pw-strength" id="pw-strength">
                  <div class="pw-bar" id="pw-bar"></div>
                </div>
                <span class="pw-label" id="pw-label"></span>
              </div>

              <div class="field">
                <label for="confirm">Confirm password</label>
                <div class="field-inner">
                  <i class="fas fa-lock field-icon"></i>
                  <input id="confirm" type="password" name="confirm" placeholder="Repeat your password" required />
                  <button type="button" class="toggle-pw" onclick="togglePw('confirm', 'icon-pw2')" aria-label="Toggle confirm">
                    <i class="fas fa-eye" id="icon-pw2"></i>
                  </button>
                </div>
              </div>
            </div>

            <label class="terms-check">
              <input type="checkbox" name="terms" required />
              <span>I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a></span>
            </label>

            <button type="submit" class="btn-register">
              <span>Create my account &nbsp;<i class="fas fa-arrow-right"></i></span>
            </button>
          </form>

          <p class="login-cta" style="margin-top: 22px">
            Already have an account? <a href="{{ path('app_login') }}">Sign in here</a>
          </p>
        </div>
      </div>

      <footer>
        <span>© 2026 UniAssistant · INSAT</span>
        <nav>
          <a href="#">Terms of Service</a>
          <a href="#">Privacy Policy</a>
          <a href="#">Contact</a>
        </nav>
      </footer>
