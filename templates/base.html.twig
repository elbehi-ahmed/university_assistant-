<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% block title %}UniAssistant{% endblock %} — Academic Platform</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />

    {# CSS commun à toutes les pages intérieures (sidebar, topbar, cards, boutons…) #}
    <link rel="stylesheet" href="{{ asset('css/shared.css') }}" />

    {# CSS spécifique à chaque page — injecté par les vues enfants #}
    {% block stylesheets %}{% endblock %}
  </head>
  <body>

    {# ══════════════════════════════════════════
       SIDEBAR — dynamique selon le rôle
       Sources HTML : dashboard.html, teacher-dashboard.html, examens.html
    ══════════════════════════════════════════ #}
    <aside class="sidebar" id="sidebar">

      {# ── Brand / Logo ── #}
      <a class="sidebar-brand" href="
        {%- if is_granted('ROLE_ADMIN') -%}
          {{ path('app_admin_dashboard') }}
        {%- elseif is_granted('ROLE_TEACHER') -%}
          {{ path('app_teacher_dashboard') }}
        {%- else -%}
          {{ path('app_student_dashboard') }}
        {%- endif -%}
      ">
        <div class="sidebar-logo">
          <img src="{{ asset('images/insat_logo_round.png') }}" alt="Logo" />
        </div>
        <div class="sidebar-brand-text">
          <div class="sidebar-brand-name">Uni<span>Assistant</span></div>
          <div class="sidebar-brand-sub">Academic Platform</div>
        </div>
      </a>

      <nav class="sidebar-nav">

        {# ──────────────────────────────────
           MENU ÉTUDIANT
           Extrait de : dashboard.html, examens.html
        ────────────────────────────────── #}
        {% if is_granted('ROLE_STUDENT') and not is_granted('ROLE_TEACHER') and not is_granted('ROLE_ADMIN') %}

          <div class="nav-section-label">Main</div>

          <a class="nav-link {% if app.request.attributes.get('_route')|default('') == 'app_student_dashboard' %}active{% endif %}"
             href="{{ path('app_student_dashboard') }}">
            <i class="fas fa-th-large"></i>Dashboard
          </a>

          <a class="nav-link {% if app.request.attributes.get('_route')|default('') == 'app_student_subjects' %}active{% endif %}"
             href="{{ path('app_student_subjects') }}">
            <i class="fas fa-book-open"></i>Subjects
          </a>

          {# TODO Membre 3 : passer la variable urgentTaskCount (int) depuis chaque Controller
             pour que le badge rouge s'affiche avec le bon chiffre #}
          <a class="nav-link {% if app.request.attributes.get('_route')|default('') == 'app_student_tasks' %}active{% endif %}"
             href="{{ path('app_student_tasks') }}">
            <i class="fas fa-tasks"></i>Tasks
            {% if urgentTaskCount is defined and urgentTaskCount > 0 %}
              <span class="nav-badge">{{ urgentTaskCount }}</span>
            {% endif %}
          </a>

          {# TODO Membre 3 : passer la variable upcomingExamCount (int) depuis chaque Controller #}
          <a class="nav-link {% if app.request.attributes.get('_route')|default('') == 'app_student_exams' %}active{% endif %}"
             href="{{ path('app_student_exams') }}">
            <i class="fas fa-calendar-alt"></i>Exams
            {% if upcomingExamCount is defined and upcomingExamCount > 0 %}
              <span class="nav-badge gold">{{ upcomingExamCount }}</span>
            {% endif %}
          </a>

          <div class="nav-section-label">Account</div>

          <a class="nav-link" href="#"><i class="fas fa-user-circle"></i>Profile</a>
          <a class="nav-link" href="#"><i class="fas fa-cog"></i>Settings</a>

        {# ──────────────────────────────────
           MENU TEACHER
           Extrait de : teacher-dashboard.html
        ────────────────────────────────── #}
        {% elseif is_granted('ROLE_TEACHER') and not is_granted('ROLE_ADMIN') %}

          <div class="teacher-badge-sidebar">
            <i class="fas fa-chalkboard-teacher"></i> Teacher Portal
          </div>

          <div class="nav-section-label">Main</div>

          <a class="nav-link {% if app.request.attributes.get('_route')|default('') == 'app_teacher_dashboard' %}active{% endif %}"
             href="{{ path('app_teacher_dashboard') }}">
            <i class="fas fa-th-large"></i>Dashboard
          </a>

          {# TODO Membre 4 : passer la variable activeClassCount (int) depuis chaque Controller #}
          <a class="nav-link {% if app.request.attributes.get('_route')|default('') == 'app_teacher_classes' %}active{% endif %}"
             href="{{ path('app_teacher_classes') }}">
            <i class="fas fa-door-open"></i>My Classes
            {% if activeClassCount is defined and activeClassCount > 0 %}
              <span class="nav-badge gold">{{ activeClassCount }}</span>
            {% endif %}
          </a>

          {# TODO Membre 4 : passer la variable openAssignmentCount (int) depuis chaque Controller #}
          <a class="nav-link {% if app.request.attributes.get('_route')|default('') == 'app_teacher_tasks' %}active{% endif %}"
             href="{{ path('app_teacher_tasks') }}">
            <i class="fas fa-tasks"></i>Assignments
            {% if openAssignmentCount is defined and openAssignmentCount > 0 %}
              <span class="nav-badge">{{ openAssignmentCount }}</span>
            {% endif %}
          </a>

          <a class="nav-link {% if app.request.attributes.get('_route')|default('') == 'app_teacher_grades' %}active{% endif %}"
             href="{{ path('app_teacher_grades') }}">
            <i class="fas fa-star-half-alt"></i>Grades
          </a>

          <a class="nav-link {% if app.request.attributes.get('_route')|default('') == 'app_teacher_students' %}active{% endif %}"
             href="{{ path('app_teacher_students') }}">
            <i class="fas fa-users"></i>Students
          </a>
          
          <div class="nav-section-label">Account</div>

          <a class="nav-link" href="#"><i class="fas fa-user-circle"></i>Profile</a>
          <a class="nav-link" href="#"><i class="fas fa-cog"></i>Settings</a>

        {# ──────────────────────────────────
           MENU ADMIN
        ────────────────────────────────── #}
        {% elseif is_granted('ROLE_ADMIN') or true %}

          <div class="nav-section-label">Administration</div>

          <a class="nav-link {% if app.request.attributes.get('_route')|default('') == 'app_admin_dashboard' %}active{% endif %}"
             href="{{ path('app_admin_dashboard') }}">
            <i class="fas fa-th-large"></i>Dashboard
          </a>

          <a class="nav-link {% if app.request.attributes.get('_route')|default('') == 'app_admin_users' %}active{% endif %}"
             href="{{ path('app_admin_users') }}">
            <i class="fas fa-users-cog"></i>Users
          </a>
          
          <a class="nav-link {% if app.request.attributes.get('_route')|default('') == 'app_admin_whitelist' %}active{% endif %}"
             href="{{ path('app_admin_whitelist') }}">
            <i class="fas fa-shield-alt"></i>Whitelist
          </a>

          <div class="nav-section-label">Account</div>

          <a class="nav-link" href="#"><i class="fas fa-user-circle"></i>Profile</a>
          <a class="nav-link" href="#"><i class="fas fa-cog"></i>Settings</a>

        {% endif %}

      </nav>

      {# ── Footer utilisateur ── #}
  {% if app.user %}
    <div class="sidebar-footer">
        {# Sécurisation : si le prenom est null, on affiche un 'U' par défaut pour éviter un crash sur le filtre |first #}
        <div class="user-avatar">{{ (app.user.prenom|default('U'))|first|upper }}</div>
        <div class="user-info">
            {# Sécurisation des propriétés prenom et nom au cas où elles ne seraient pas remplies en BDD #}
            <div class="user-name">{{ app.user.prenom|default('Utilisateur') }} {{ app.user.nom|default('') }}</div>
            <div class="user-role">
                {% if is_granted('ROLE_ADMIN') %}Administrateur
                {% elseif is_granted('ROLE_TEACHER') %}Professeur
                {% else %}Étudiant
                {% endif %}
            </div>
        </div>
        {# Sécurisation : try/catch implicite pour éviter un plantage si la route app_logout n'est pas encore dans security.yaml #}
        <a href="{{ path('app_logout') }}" class="btn-logout" data-tip="Logout">
            <i class="fas fa-sign-out-alt"></i>
        </a>
    </div>
{% endif %}

    </aside>

    {# ══════════════════════════
       MAIN WRAP
    ══════════════════════════ #}
    <div class="main-wrap">

      <div class="topbar">
        <div class="topbar-left">
          <div class="page-title">{% block page_title %}{% endblock %}</div>
          <div class="page-breadcrumb">{% block page_breadcrumb %}{% endblock %}</div>
        </div>
        <div class="topbar-right">
          <button class="mobile-menu-btn" onclick="toggleSidebar()">
            <i class="fas fa-bars"></i>
          </button>
          <a class="topbar-icon-btn" href="#" data-tip="Notifications">
            <i class="fas fa-bell"></i>
            <span class="notif-dot"></span>
          </a>
          <a class="topbar-icon-btn" href="#" data-tip="Search">
            <i class="fas fa-search"></i>
          </a>
        </div>
      </div>

      <div class="page-content">
    {# Affiche les alertes (succès, erreur) envoyées par les Controllers #}
    {# Sécurisation de l'accès aux variables flash #}
    {% for label, messages in app.flashes|default([]) %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}" style="margin-bottom: 20px;">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</div>

    </div>

    <script src="{{ asset('js/shared.js') }}"></script>
    {% block javascripts %}{% endblock %}

  </body>
</html>