{% extends 'base.html.twig' %}

{# TODO Membre 3 : Ce Controller (StudentExamsController) doit passer :
   - upcomingExams  : Exam[]   — examens futurs triés par date croissante
   - pastExams      : Exam[]   — examens passés triés par date décroissante
   - nextExam       : Exam|null — premier examen à venir (pour le widget countdown)
   - subjects       : Subject[] — pour le <select> du modal "Schedule exam"

   Chaque objet Exam expose :
     subject.name         (string)
     examDate             (DateTime)
     room                 (string, ex: "Room A12")
     startTime            (string, ex: "09:00")
     endTime              (string, ex: "11:00")
     duration             (string, ex: "2 hours")
     countdownClass       (string : ''|'moderate'|'past-label')
     countdownIconClass   (string : 'fa-fire'|'fa-calendar'|'fa-check-circle')
     countdownLabel       (string, ex: "In 5 days — prepare now!")
     urgencyBadgeClass    (string : 'badge-danger'|'badge-warning'|'badge-muted')
     urgencyBadgeLabel    (string : 'Urgent'|'Soon'|'Past')
#}

{% block title %}Exams{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/examens.css') }}" />
{% endblock %}

{% block page_title %}Exams{% endblock %}

{% block page_breadcrumb %}
  <span>Dashboard</span> / Exams
{% endblock %}

{% block body %}

  {# ── Toolbar (source : examens.html) ── #}
  <div class="flex items-center justify-between mb-24 anim-1" style="flex-wrap: wrap; gap: 12px">
    <div class="search-wrap">
      <i class="fas fa-search search-icon"></i>
      <input
        class="search-input"
        type="text"
        placeholder="Search exams…"
        oninput="filterExams(this.value)"
      />
    </div>
    <button class="btn btn-primary" onclick="openModal()">
      <i class="fas fa-plus"></i> Schedule exam
    </button>
  </div>

  {# ── Layout deux colonnes (source : examens.html — .exams-layout) ── #}
  <div class="exams-layout anim-2">

    {# ════════════════════════
       Timeline des exam cards
    ════════════════════════ #}
    <div class="exams-list" id="exams-list">

      {# ── Section Upcoming ── #}
      {% if upcomingExams is not empty %}

        <div class="timeline-section-label">Upcoming</div>

        {# TODO Membre 3 : boucler sur upcomingExams[] #}
        {% for exam in upcomingExams %}
          <div class="exam-card upcoming" data-subject="{{ exam.subject.name|lower }}">

            <div class="exam-card-left">
              <div class="exam-big-date">
                {# TODO Membre 3 : exam.examDate est un DateTime #}
                <div class="ebd-day">{{ exam.examDate|date('d') }}</div>
                <div class="ebd-month">{{ exam.examDate|date('F') }}</div>
                <div class="ebd-year">{{ exam.examDate|date('Y') }}</div>
              </div>
            </div>

            <div class="exam-card-body">
              <div class="exam-card-subject">{{ exam.subject.name }}</div>
              <div class="exam-card-details">
                <span><i class="fas fa-map-marker-alt"></i> {{ exam.room }}</span>
                <span><i class="far fa-clock"></i> {{ exam.startTime }} – {{ exam.endTime }}</span>
                <span><i class="fas fa-hourglass-half"></i> {{ exam.duration }}</span>
              </div>
              {# TODO Membre 3 : exam.countdownClass, exam.countdownIconClass, exam.countdownLabel #}
              <div class="exam-countdown {{ exam.countdownClass }}">
                <i class="fas {{ exam.countdownIconClass }}"></i> {{ exam.countdownLabel }}
              </div>
            </div>

            <div class="exam-card-actions">
              {# TODO Membre 3 : exam.urgencyBadgeClass, exam.urgencyBadgeLabel #}
              <span class="badge {{ exam.urgencyBadgeClass }} mb-8">{{ exam.urgencyBadgeLabel }}</span>
              <button
                class="btn btn-ghost btn-icon btn-sm"
                onclick="openModal('{{ exam.subject.name }}')"
                data-tip="Edit"
              >
                <i class="fas fa-pen"></i>
              </button>
              <button class="btn btn-danger btn-icon btn-sm" data-tip="Delete">
                <i class="fas fa-trash"></i>
              </button>
            </div>

          </div>
        {% endfor %}

      {% endif %}

      {# ── Section Past exams ── #}
      {% if pastExams is not empty %}

        <div class="timeline-section-label" style="margin-top: 28px">Past exams</div>

        {# TODO Membre 3 : boucler sur pastExams[] #}
        {% for exam in pastExams %}
          <div class="exam-card past" data-subject="{{ exam.subject.name|lower }}">

            <div class="exam-card-left">
              <div class="exam-big-date past-date">
                <div class="ebd-day">{{ exam.examDate|date('d') }}</div>
                <div class="ebd-month">{{ exam.examDate|date('F') }}</div>
                <div class="ebd-year">{{ exam.examDate|date('Y') }}</div>
              </div>
            </div>

            <div class="exam-card-body">
              <div class="exam-card-subject" style="opacity: 0.65">{{ exam.subject.name }}</div>
              <div class="exam-card-details">
                <span><i class="fas fa-map-marker-alt"></i> {{ exam.room }}</span>
                <span><i class="far fa-clock"></i> {{ exam.startTime }} – {{ exam.endTime }}</span>
              </div>
              <div class="exam-countdown past-label">
                <i class="fas fa-check-circle"></i> Completed
              </div>
            </div>

            <div class="exam-card-actions">
              <span class="badge badge-muted mb-8">Past</span>
              <button class="btn btn-ghost btn-icon btn-sm" data-tip="Edit">
                <i class="fas fa-pen"></i>
              </button>
              <button class="btn btn-danger btn-icon btn-sm" data-tip="Delete">
                <i class="fas fa-trash"></i>
              </button>
            </div>

          </div>
        {% endfor %}

      {% endif %}

    </div>{# /exams-list #}

    {# ════════════════════════
       Aside : countdown + schedule
       Source : examens.html — .exams-aside
    ════════════════════════ #}
    <div class="exams-aside">

      {# ── Next exam countdown ── #}
      <div class="card mb-16">
        <div class="card-head">
          <div class="card-title">Next Exam</div>
          <div class="gold-line"></div>
        </div>
        <div class="card-body" style="text-align: center">
          {# TODO Membre 3 : nextExam est le 1er examen à venir (peut être null) #}
          <div class="next-exam-subject">{{ nextExam.subject.name }}</div>
          {# Le JS lit l'attribut data-date pour calculer le compte à rebours en live #}
          <div class="countdown-display" id="countdown"
               data-date="{{ nextExam.examDate|date('Y-m-d') }}T{{ nextExam.startTime }}">—</div>
          <div class="next-exam-detail">
            <i class="fas fa-map-marker-alt"></i> {{ nextExam.room }}
            &nbsp;·&nbsp; {{ nextExam.startTime }}
          </div>
          <a
            href="{{ path('app_student_tasks') }}"
            class="btn btn-primary"
            style="margin-top: 18px; width: 100%; justify-content: center"
          >
            <i class="fas fa-tasks"></i> View related tasks
          </a>
        </div>
      </div>

      {# ── Exam Schedule mini-liste ── #}
      <div class="card">
        <div class="card-head">
          <div class="card-title">Exam Schedule</div>
          <div class="gold-line"></div>
        </div>
        <div class="card-body">
          <div class="schedule-list">

            {# TODO Membre 3 : boucler sur upcomingExams pour les entrées "actives"
               puis sur pastExams pour les entrées "past-sched" #}
            {% for exam in upcomingExams %}
              <div class="schedule-item">
                {# dot danger pour le 1er, warning pour les suivants — reproduit le comportement statique #}
                <div class="si-dot {{ loop.first ? 'danger' : 'warning' }}"></div>
                <div class="si-info">
                  <div class="si-subject">{{ exam.subject.name }}</div>
                  <div class="si-date">
                    {{ exam.examDate|date('M j') }} · {{ exam.room }} · {{ exam.startTime }}
                  </div>
                </div>
              </div>
            {% endfor %}

            {% for exam in pastExams %}
              <div class="schedule-item past-sched">
                <div class="si-dot muted"></div>
                <div class="si-info">
                  <div class="si-subject">{{ exam.subject.name }}</div>
                  <div class="si-date">
                    {{ exam.examDate|date('M j') }} · {{ exam.room }} · {{ exam.startTime }}
                  </div>
                </div>
              </div>
            {% endfor %}

          </div>
        </div>
      </div>

    </div>{# /exams-aside #}

  </div>{# /exams-layout #}

  {# ════════════════════════
     Modal Add / Edit
     Source : examens.html — #exam-modal
  ════════════════════════ #}
  <div class="modal-overlay" id="exam-modal" onclick="handleOverlayClick(event)">
    <div class="modal" style="max-width: 480px">
      <div class="modal-head">
        <div class="modal-title" id="exam-modal-title">Schedule exam</div>
        <button class="modal-close" onclick="closeModal()">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Subject</label>
          <select class="form-control" id="e-subject">
            <option value="">Select subject</option>
            {# TODO Membre 3 : boucler sur subjects[] pour alimenter le <select>
               Chaque Subject expose : id, name #}
            {% for subject in subjects %}
              <option value="{{ subject.id }}">{{ subject.name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="grid-2">
          <div class="form-group">
            <label class="form-label">Date</label>
            <input class="form-control" type="date" id="e-date" />
          </div>
          <div class="form-group">
            <label class="form-label">Time</label>
            <input class="form-control" type="time" id="e-time" />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Room / Location</label>
          <input class="form-control" type="text" id="e-room" placeholder="e.g. Room A12" />
        </div>
        <div class="form-group">
          <label class="form-label">Notes (optional)</label>
          <textarea
            class="form-control"
            id="e-notes"
            placeholder="Topics covered, allowed materials…"
          ></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
        <button class="btn btn-primary" onclick="closeModal()">
          <i class="fas fa-save"></i> Save exam
        </button>
      </div>
    </div>
  </div>

{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/student.js') }}"></script>
{% endblock %}