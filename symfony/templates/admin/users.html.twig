{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}

{% block page_title %}Utilisateurs{% endblock %}
{% block page_breadcrumb %}
    <span>Administration</span> / Gestion des Utilisateurs
{% endblock %}

{% block stylesheets %}
<style>
    .users-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .toolbar-left {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .filter-select {
        background: rgba(255,255,255,0.05);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-sm);
        padding: 9px 14px;
        font-size: 0.85rem;
        color: var(--muted-less);
        font-family: 'DM Sans', sans-serif;
        outline: none;
        cursor: pointer;
        transition: border-color var(--transition);
    }

    .filter-select:focus { border-color: var(--gold); }
    .filter-select option { background: var(--navy-mid); color: var(--white); }

    .user-cell {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .user-mini-avatar {
        width: 32px; height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--gold-dim), var(--gold));
        display: flex; align-items: center; justify-content: center;
        font-family: 'Playfair Display', serif;
        font-size: 0.78rem;
        color: var(--navy);
        font-weight: 700;
        flex-shrink: 0;
    }

    .user-mini-avatar.teacher {
        background: linear-gradient(135deg, #2e6eb0, var(--info));
        color: #fff;
    }

    .user-mini-avatar.admin {
        background: linear-gradient(135deg, #8b2020, var(--danger));
        color: #fff;
    }

    .user-fullname {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--white);
        line-height: 1.2;
    }

    .user-id-hint {
        font-size: 0.68rem;
        color: var(--muted);
    }

    .actions-cell {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .result-count {
        font-size: 0.78rem;
        color: var(--muted);
        padding: 6px 12px;
        background: rgba(255,255,255,0.04);
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-dim);
    }

    .result-count strong { color: var(--gold-light); }
</style>
{% endblock %}

{% block body %}
<div class="anim-1">

    {# ── Toolbar ── #}
    <div class="users-toolbar anim-2">
        <div class="toolbar-left">

            <div class="search-wrap">
                <i class="fas fa-search search-icon"></i>
                {# TODO Membre 4 : lier cet input à un formulaire de filtrage GET #}
                <input
                    type="text"
                    class="search-input"
                    placeholder="Rechercher un utilisateur…"
                    value="{{ app.request.query.get('q')|default('') }}"
                />
            </div>

            {# TODO Membre 4 : lier ce select au filtre de rôle GET #}
            <select class="filter-select">
                <option value="">Tous les rôles</option>
                <option value="ROLE_STUDENT"  {% if app.request.query.get('role')|default('') == 'ROLE_STUDENT'  %}selected{% endif %}>Étudiants</option>
                <option value="ROLE_TEACHER"  {% if app.request.query.get('role')|default('') == 'ROLE_TEACHER'  %}selected{% endif %}>Professeurs</option>
                <option value="ROLE_ADMIN"    {% if app.request.query.get('role')|default('') == 'ROLE_ADMIN'    %}selected{% endif %}>Admins</option>
            </select>

            <div class="result-count">
                <strong>{{ users is defined ? users|length : 0 }}</strong> résultat(s)
            </div>

        </div>

        {# TODO Membre 4 : remplacer '#' par path('app_admin_user_create') #}
        <a href="#" class="btn btn-primary">
            <i class="fas fa-user-plus"></i> Créer un Utilisateur
        </a>
    </div>

    {# ── Table Card ── #}
    <div class="card anim-3">
        <div class="card-head">
            <div class="card-title"><i class="fas fa-users-cog" style="color:var(--gold);margin-right:8px;"></i>Liste des Utilisateurs</div>
        </div>

        <div class="card-body" style="padding: 0;">
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Nom Complet</th>
                            <th>Email</th>
                            <th>Rôle</th>
                            <th>Statut</th>
                            <th>Inscrit le</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>

                        {# TODO Membre 4 : injecter la variable `users` (collection d'entités User) depuis le Controller #}
                        {% for user in users|default([]) %}
                        <tr>

                            {# ID #}
                            <td style="color:var(--muted);font-size:0.8rem;">#{{ user.id|default('N/A') }}</td>

                            {# Nom Complet avec mini-avatar #}
                            <td>
                                <div class="user-cell">
                                    <div class="user-mini-avatar
                                        {%- if 'ROLE_ADMIN' in user.roles|default([]) %} admin
                                        {%- elseif 'ROLE_TEACHER' in user.roles|default([]) %} teacher
                                        {%- endif -%}">
                                        {{ (user.prenom|default('U'))|first|upper }}
                                    </div>
                                    <div>
                                        <div class="user-fullname">{{ user.nom|default('') }} {{ user.prenom|default('Utilisateur') }}</div>
                                    </div>
                                </div>
                            </td>

                            {# Email #}
                            <td style="font-size:0.85rem;">{{ user.email|default('Non renseigné') }}</td>

                            {# Rôle — badge dynamique #}
                            <td>
                                {% if 'ROLE_ADMIN' in user.roles|default([]) %}
                                    <span class="badge badge-danger">
                                        <i class="fas fa-shield-alt"></i> Admin
                                    </span>
                                {% elseif 'ROLE_TEACHER' in user.roles|default([]) %}
                                    <span class="badge badge-info">
                                        <i class="fas fa-chalkboard-teacher"></i> Professeur
                                    </span>
                                {% else %}
                                    <span class="badge badge-gold">
                                        <i class="fas fa-user-graduate"></i> Étudiant
                                    </span>
                                {% endif %}
                            </td>

                            {# Statut — TODO Membre 4 : adapter selon votre champ `isActive` ou `isSuspended` #}
                            <td>
                                {% if user.isActive is defined and not user.isActive %}
                                    <span class="badge badge-danger"><i class="fas fa-ban"></i> Suspendu</span>
                                {% else %}
                                    <span class="badge badge-success"><i class="fas fa-check-circle"></i> Actif</span>
                                {% endif %}
                            </td>

                            {# Date d'inscription #}
                            <td style="font-size:0.82rem;color:var(--muted);">
                                {{ user.createdAt is defined and user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}
                            </td>

                            {# Actions #}
                            <td>
                                <div class="actions-cell">
                                    {# TODO Membre 4 : remplacer '#' par path('app_admin_user_edit', {id: user.id}) #}
                                    <a href="#" class="btn btn-ghost btn-icon btn-sm" data-tip="Modifier">
                                        <i class="fas fa-pen"></i>
                                    </a>

                                    {# TODO Membre 4 : remplacer '#' par path('app_admin_user_delete', {id: user.id}) + confirmation CSRF #}
                                    <a href="#" class="btn btn-danger btn-icon btn-sm" data-tip="Supprimer"
                                       onclick="return confirm('Supprimer cet utilisateur ?')">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                            </td>

                        </tr>

                        {% else %}

                        {# État vide #}
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <div class="empty-icon"><i class="fas fa-users-slash"></i></div>
                                    <div class="empty-title">Aucun utilisateur trouvé</div>
                                    <div class="empty-desc">Aucun résultat ne correspond à votre recherche, ou la base est vide.</div>
                                </div>
                            </td>
                        </tr>

                        {% endfor %}

                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/admin.js') }}"></script>
{% endblock %}